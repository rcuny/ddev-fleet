#!/usr/bin/env bash
# Production build check (composer run prod-check).
#
# The gates run with dev dependencies and APP_ENV=dev|test. This script proves the production path in a
# throw-away copy of app/: composer install --no-dev, the asset pipeline (importmap, minified Tailwind,
# asset-map:compile), a prod cache warm-up and container lint, the boot guard (empty APP_SECRET), and a real
# php -S server answering /health and the authentication paths with the compiled prod kernel.
#
# Needs network (Composer, jsDelivr via importmap, the Tailwind binary, unless var/tailwind already exists),
# curl and tar. Override the PHP binary with FLEET_PHP. Nothing in app/ is modified.
set -euo pipefail

source_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
php="${FLEET_PHP:-$(command -v php8.4 || command -v php)}"
composer="$(command -v composer)"
work="$(mktemp -d)"
server_pid=""

cleanup() {
    if [ -n "$server_pid" ]; then
        kill "$server_pid" 2>/dev/null || true
    fi
    rm -rf "$work"
}
trap cleanup EXIT

step() { printf '\n==> %s\n' "$*"; }
fail() { printf 'prod-check FAILED: %s\n' "$*" >&2; exit 1; }

step "copy app/ without vendor, var, build output and local env files"
mkdir "$work/app"
tar -C "$source_dir" \
    --exclude=./vendor --exclude=./var --exclude=./node_modules --exclude=./public/assets \
    --exclude=./public/bundles --exclude=./.phpunit.cache --exclude=./.env.local --exclude='./.env.*.local' \
    --exclude=./.env.local.php -cf - . | tar -C "$work/app" -xf -
if [ -d "$source_dir/var/tailwind" ]; then
    mkdir -p "$work/app/var"
    cp -a "$source_dir/var/tailwind" "$work/app/var/tailwind"
fi
cd "$work/app"

# What a deployment sets in the real environment; the committed .env is dev-safe and not enough for prod.
export APP_ENV=prod APP_DEBUG=0 FLEET_RUNNER=process FLEET_HOME="$work/home"
APP_SECRET="$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
MERCURE_JWT_SECRET="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
export APP_SECRET MERCURE_JWT_SECRET

step "composer install --no-dev"
"$php" "$composer" install --no-dev --no-scripts --no-interaction --prefer-dist --optimize-autoloader
for dev_only in symfony/web-profiler-bundle symfony/ux-toolkit symfony/debug-bundle phpunit/phpunit; do
    [ ! -d "vendor/$dev_only" ] || fail "dev-only package $dev_only was installed with --no-dev"
done

step "assets: importmap:install, tailwind:build --minify, asset-map:compile"
"$php" bin/console importmap:install --no-interaction
"$php" bin/console tailwind:build --minify --no-interaction
"$php" bin/console asset-map:compile --no-interaction
[ -f public/assets/manifest.json ] || fail "asset-map:compile wrote no public/assets/manifest.json"
compiled_css="$(find public/assets -name 'app-*.css' -o -name 'tailwind*.css' | head -n 1)"
[ -n "$compiled_css" ] || fail "no compiled stylesheet under public/assets"

step "prod cache warm-up and container lint"
"$php" bin/console cache:warmup --no-interaction
"$php" bin/console lint:container --no-interaction

step "the boot guard refuses an empty APP_SECRET and the recording runner"
refused="$(APP_SECRET= "$php" bin/console about 2>&1 || true)"
case "$refused" in *"Refusing to boot in prod: APP_SECRET is empty"*) ;; *) fail "prod did not refuse an empty APP_SECRET";; esac
refused="$(FLEET_RUNNER=recording "$php" bin/console about 2>&1 || true)"
case "$refused" in *"Refusing to boot in prod: FLEET_RUNNER=recording"*) ;; *) fail "prod did not refuse FLEET_RUNNER=recording";; esac

step "serve the compiled app with php -S and probe it"
port=$((20000 + RANDOM % 20000))
"$php" -S "127.0.0.1:$port" -t public >"$work/server.log" 2>&1 &
server_pid=$!
for _ in $(seq 1 50); do
    curl -s -o /dev/null "http://127.0.0.1:$port/health" && break
    sleep 0.2
done

status() { curl -s -o /dev/null -w '%{http_code}' "$@"; }
expect() { # expect <code> <description> <curl args...>
    local want="$1" what="$2"; shift 2
    local got
    got="$(status "$@")"
    [ "$got" = "$want" ] || { cat "$work/server.log" >&2; fail "$what: expected HTTP $want, got $got"; }
    printf 'ok  %s (%s)\n' "$what" "$got"
}
base="http://127.0.0.1:$port"
expect 200 "/health is public" "$base/health"
expect 401 "/ without a proxy identity" "$base/"
expect 200 "/ with Remote-User from a trusted peer" -H 'Remote-User: check' -H 'Remote-Groups: fleet-admins' "$base/"
expect 401 "the stand-in header does not authenticate" -H 'X-Fleet-Stand-In-Role: admin' "$base/"
expect 404 "the stand-in switch route does not exist" "$base/_dev/stand-in/admin"
expect 200 "the compiled stylesheet is served" "$base/${compiled_css#public/}"

printf '\nprod-check OK\n'
