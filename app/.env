# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> fleet/home ###
# Everything the app persists lives under FLEET_HOME (see App\Fleet\FleetPaths).
# The default is project-relative for development; production sets an absolute path (e.g. /srv/fleet).
FLEET_HOME=%kernel.project_dir%/var/fleet-home
# process = real host commands; recording = fake used in dev/test (set in .env.dev / .env.test)
FLEET_RUNNER=process
# Where Caddy imports the fleet snippets from (gate.conf, instance sites). Production sets /etc/caddy/fleet.
FLEET_CADDY_DIR=%env(resolve:FLEET_HOME)%/caddy
###< fleet/home ###

###> fleet/auth ###
# Peers allowed to assert Remote-User/Groups/Email/Name (IPs and CIDRs, comma separated).
FLEET_TRUSTED_PROXIES=127.0.0.1,::1
# Shared secret between Caddy and the app: Caddy passes it as the FastCGI parameter FLEET_PROXY_AUTH, and a request
# carrying it is trusted to assert the identity headers whatever its peer address (a client cannot set FastCGI
# params). Intentionally empty (and under 32 characters = disabled): the installer generates it into the real
# environment, never commit one. Production leaves FLEET_TRUSTED_PROXIES empty when it is set.
FLEET_PROXY_SECRET=
# Members of this group are administrators; everyone else authenticated is a member.
FLEET_ADMIN_GROUP=fleet-admins
###< fleet/auth ###

###> fleet/stand-in ###
# The dev/test stand-in's default role, fail-closed here. .env.dev and .env.test opt into "admin" for local work.
# The stand-in does not exist in prod, and a prod kernel refuses to boot without a real APP_SECRET and with
# FLEET_RUNNER=recording (App\ProductionGuard), so a forgotten override cannot silently run unsafely.
FLEET_STAND_IN_ROLE=none
###< fleet/stand-in ###

###> symfony/lock ###
LOCK_DSN="flock://%env(resolve:FLEET_HOME)%/locks"
###< symfony/lock ###

###> doctrine/doctrine-bundle ###
# Two SQLite files: domain data and the Messenger queue.
DATABASE_URL="sqlite:///%env(resolve:FLEET_HOME)%/var/fleet.sqlite"
QUEUE_DATABASE_URL="sqlite:///%env(resolve:FLEET_HOME)%/var/queue.sqlite"
###< doctrine/doctrine-bundle ###

###> symfony/mercure-bundle ###
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
MERCURE_PUBLIC_URL=/.well-known/mercure
# Intentionally empty: production supplies the secret through the real environment.
# .env.dev and .env.test carry a development-only value.
MERCURE_JWT_SECRET=
MERCURE_JWT_ISSUER=fleet
###< symfony/mercure-bundle ###
