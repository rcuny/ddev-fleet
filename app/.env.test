# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET=test-secret-not-for-production
MERCURE_JWT_SECRET=test-only-mercure-jwt-secret-0123456789abcdef

# Command seam: record instead of executing host commands.
FLEET_RUNNER=recording

###> fleet/stand-in ###
# Development stand-in identities (the stand-in does not exist in prod).
FLEET_STAND_IN_ROLE=admin
FLEET_STAND_IN_ADMIN_USER=dev-admin
FLEET_STAND_IN_ADMIN_GROUPS=fleet-admins
FLEET_STAND_IN_MEMBER_USER=dev-member
FLEET_STAND_IN_MEMBER_GROUPS=demo
