{#- The filter bar, bulk bar and rows, inside <turbo-frame id="instances"> as ONE form. Needs: rows, total, projectNames, states, filters, canDeploy, canDestroy. -#}
<form method="get" action="{{ path('instances') }}" data-testid="instances-form" data-instance-list-target="form" data-action="submit->instance-list#filter">
    {{ include('setup/_csrf.html.twig') }}

    <div class="mb-4 grid gap-2 md:grid-cols-[minmax(0,1fr)_auto_auto_auto]" data-testid="instance-filters">
        <twig:Input type="search" name="q" value="{{ filters.q }}" placeholder="Search instances" aria-label="Search instances" class="h-11 md:h-8" />
        <twig:NativeSelect name="project" aria-label="Project" class="w-full md:w-44 [&_select]:h-11 md:[&_select]:h-8">
            <twig:NativeSelect:Option value="">All projects</twig:NativeSelect:Option>
            {% for name in projectNames %}
                <twig:NativeSelect:Option value="{{ name }}" selected="{{ filters.project == name ? 'selected' : null }}">{{ name }}</twig:NativeSelect:Option>
            {% endfor %}
        </twig:NativeSelect>
        <twig:NativeSelect name="state" aria-label="State" class="w-full md:w-40 [&_select]:h-11 md:[&_select]:h-8">
            <twig:NativeSelect:Option value="">Any state</twig:NativeSelect:Option>
            {% for state in states %}
                <twig:NativeSelect:Option value="{{ state.value }}" selected="{{ filters.state == state.value ? 'selected' : null }}">{{ state.value|capitalize }}</twig:NativeSelect:Option>
            {% endfor %}
        </twig:NativeSelect>
        <twig:Button type="submit" variant="outline" class="h-11 md:h-8" data-testid="filter-submit">Filter</twig:Button>
    </div>

    <div data-testid="bulk-bar" data-instance-list-target="bar" hidden class="sticky top-0 z-10 mb-4 flex flex-wrap items-center gap-2 rounded-md border border-hairline bg-surface p-2">
        <span class="px-1 text-sm" data-instance-list-target="count">0 selected</span>
        <twig:Button type="submit" variant="outline" class="h-11 md:h-8" name="action" value="start" formaction="{{ path('instance_bulk') }}" formmethod="post" data-turbo-frame="_top">Start</twig:Button>
        <twig:Button type="submit" variant="outline" class="h-11 md:h-8" name="action" value="stop" formaction="{{ path('instance_bulk') }}" formmethod="post" data-turbo-frame="_top">Stop</twig:Button>
        <twig:Dialog id="bulk-redeploy" class="inline-block">
            <twig:Dialog:Trigger>
                <twig:Button type="button" variant="outline" class="h-11 md:h-8" {{ ...dialog_trigger_attrs|merge({'data-action': 'click->dialog#open click->instance-list#fillConfirm'}) }}>Redeploy…</twig:Button>
            </twig:Dialog:Trigger>
            <twig:Dialog:Content>
                <twig:Dialog:Header>
                    <twig:Dialog:Title>Redeploy the selected instances?</twig:Dialog:Title>
                    <twig:Dialog:Description>Each one is rebuilt from its template, one after the other.</twig:Dialog:Description>
                </twig:Dialog:Header>
                <ul class="max-h-40 overflow-y-auto text-sm [overflow-wrap:anywhere]" data-instance-list-target="ids"></ul>
                <twig:Dialog:Footer>
                    <twig:Dialog:Close>
                        <twig:Button type="button" variant="outline" class="h-11 w-full md:h-8 md:w-auto" {{ ...dialog_close_attrs }}>Cancel</twig:Button>
                    </twig:Dialog:Close>
                    <twig:Button type="submit" class="h-11 w-full md:h-8 md:w-auto" name="action" value="redeploy" formaction="{{ path('instance_bulk') }}" formmethod="post" data-turbo-frame="_top">Redeploy</twig:Button>
                </twig:Dialog:Footer>
            </twig:Dialog:Content>
        </twig:Dialog>
        {% if canDestroy %}
            <twig:Dialog id="bulk-destroy" class="inline-block">
                <twig:Dialog:Trigger>
                    <twig:Button type="button" variant="destructive" class="h-11 md:h-8" {{ ...dialog_trigger_attrs|merge({'data-action': 'click->dialog#open click->instance-list#fillConfirm'}) }}>Destroy…</twig:Button>
                </twig:Dialog:Trigger>
                <twig:Dialog:Content>
                    <twig:Dialog:Header>
                        <twig:Dialog:Title>Destroy the selected instances?</twig:Dialog:Title>
                        <twig:Dialog:Description>Their databases and files are deleted. It cannot be undone.</twig:Dialog:Description>
                    </twig:Dialog:Header>
                    <ul class="max-h-40 overflow-y-auto text-sm [overflow-wrap:anywhere]" data-instance-list-target="ids"></ul>
                    <twig:Dialog:Footer>
                        <twig:Dialog:Close>
                            <twig:Button type="button" variant="outline" class="h-11 w-full md:h-8 md:w-auto" {{ ...dialog_close_attrs }}>Cancel</twig:Button>
                        </twig:Dialog:Close>
                        <twig:Button type="submit" variant="destructive" class="h-11 w-full md:h-8 md:w-auto" name="action" value="destroy" formaction="{{ path('instance_bulk') }}" formmethod="post" data-turbo-frame="_top">Destroy instances</twig:Button>
                    </twig:Dialog:Footer>
                </twig:Dialog:Content>
            </twig:Dialog>
        {% endif %}
    </div>

    {% if rows|length == 0 %}
        <twig:Card data-testid="instances-empty" class="max-w-xl">
            <twig:Card:Header>
                {% if total == 0 %}
                    <twig:Card:Title>No instances yet</twig:Card:Title>
                    <twig:Card:Description>{{ canDeploy ? 'Deploy a project to create the first one.' : 'Instances of your projects appear here once an administrator deploys them.' }}</twig:Card:Description>
                {% else %}
                    <twig:Card:Title>No instance matches</twig:Card:Title>
                    <twig:Card:Description>Change or clear the filters.</twig:Card:Description>
                {% endif %}
            </twig:Card:Header>
        </twig:Card>
    {% else %}
        <div class="rounded-md border border-hairline">
            <table class="block w-full text-sm md:table" data-testid="instance-table">
                <twig:Table:Header class="hidden md:table-header-group">
                    <twig:Table:Row>
                        <twig:Table:Head class="w-10">
                            <label class="flex size-8 items-center justify-center">
                                <twig:Checkbox aria-label="Select all" data-instance-list-target="all" data-action="change->instance-list#toggleAll" />
                            </label>
                        </twig:Table:Head>
                        <twig:Table:Head>Instance</twig:Table:Head>
                        <twig:Table:Head>State</twig:Table:Head>
                        <twig:Table:Head>Memory</twig:Table:Head>
                        <twig:Table:Head class="text-end">Actions</twig:Table:Head>
                    </twig:Table:Row>
                </twig:Table:Header>
                <twig:Table:Body class="block divide-y divide-hairline md:table-row-group md:divide-y-0">
                    {% for row in rows %}
                        {{ include('instances/_row.html.twig', row) }}
                    {% endfor %}
                </twig:Table:Body>
            </table>
        </div>
    {% endif %}
</form>
