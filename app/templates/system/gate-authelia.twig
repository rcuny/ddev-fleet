{% autoescape false %}
# Fleet gate, normal mode. Written by the app (GateWriter); imported from the main Caddyfile inside the identity route.
# Everything except /health, the signed webhooks (/hooks/*) and the bearer-token API (/api/v1/*) needs an Authelia session.
# /api/v1/* authenticates in the app (own firewall, no proxy identity); the Caddyfile strips Remote-* before this gate.
# The Mercure hub (/.well-known/mercure) is exempt for a request that carries `Authorization: Bearer ...` (FLE-330): the
# hub validates the JWT itself (subscribe grant on one private topic, minted by POST /api/v1/jobs/{id}/stream-token).
# A browser has no such header and keeps going through the Authelia session (the cookie token).
@fleet_gated {
    not path /health /hooks/* /api/v1/*
    not {
        path /.well-known/mercure
        header Authorization "Bearer *"
    }
}
forward_auth @fleet_gated {{ authelia }} {
    uri /api/authz/forward-auth
    copy_headers {{ copy_headers|join(' ') }}
}
{% endautoescape %}
