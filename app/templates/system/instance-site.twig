{% autoescape false %}
# Generated by Fleet for the instance {{ id }}; edits are overwritten.
{{ hosts|join(', ') }} {
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    # The identity headers never come from the client, and nothing is copied back from Authelia: the app behind the
    # instance does not read them. Only the session decides who may open the site.
    route {
{% for header in stripped_headers %}
        request_header -{{ header }}
{% endfor %}

        forward_auth {{ authelia }} {
            uri /api/authz/forward-auth
        }

        reverse_proxy {{ router }}
    }
}
{% for port in ports %}

# Named port {{ port.name }}: public {{ port.public }}, ddev router {{ port.router }}.
{{ port.hosts|join(', ') }} {
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    route {
{% for header in stripped_headers %}
        request_header -{{ header }}
{% endfor %}

        forward_auth {{ authelia }} {
            uri /api/authz/forward-auth
        }

        reverse_proxy {{ router_host }}:{{ port.router }}
    }
}
{% endfor %}
{% endautoescape %}
