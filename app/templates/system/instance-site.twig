{% autoescape false %}
# Generated by Fleet for the instance {{ id }}; edits are overwritten.
{% if wildcard %}
{% if hosts %}
# Inside the host's wildcard site (ovh_dns): a matcher and a handle, not a site block.
@i_{{ id }} host {{ hosts|join(' ') }}
handle @i_{{ id }} {
    # The identity headers never come from the client. Only Remote-Groups is copied back from Authelia, to check the
    # project group below, and it is removed again: the app behind the instance does not read identity headers.
    route {
{% for header in stripped_headers %}
        request_header -{{ header }}
{% endfor %}

        forward_auth {{ authelia }} {
            uri /api/authz/forward-auth
            copy_headers Remote-Groups
        }

        # Per-project access: the groups come from Authelia (the client's own header was stripped above).
        @forbidden_{{ id }} not header_regexp Remote-Groups `{{ groups_pattern }}`
        respond @forbidden_{{ id }} "Forbidden" 403
        request_header -Remote-Groups

        reverse_proxy {{ router }}
    }
}
{% else %}
# Every name of this instance still has its own certificate and is served from instances/{{ id }}.sites.
{% endif %}
{% else %}
{% include 'system/instance-block.twig' with {block_hosts: hosts} %}{% if ports %}
{% include 'system/instance-sites.twig' with {header: false} %}{% endif %}
{% endif %}
{% endautoescape %}
