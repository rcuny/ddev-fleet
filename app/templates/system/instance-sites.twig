{% autoescape false %}
{% if header is not defined or header %}
# Generated by Fleet for the instance {{ id }}; edits are overwritten.
{% endif %}
{% if exact_hosts %}

# Names that already hold a stored certificate keep their own site (an exact name wins over the wildcard) until it is
# near expiry; then the next render moves them under the wildcard.
{% include 'system/instance-block.twig' with {block_hosts: exact_hosts} %}{% endif %}
{% for port in ports %}

# Named port {{ port.name }}: public {{ port.public }}, ddev router {{ port.router }}.
{{ port.hosts|join(', ') }} {
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    route {
{% for header in stripped_headers %}
        request_header -{{ header }}
{% endfor %}

{% if port.public_access %}
        # Public port: no login. A browser calls it cross-origin and its preflight carries no cookie, so the service
        # is protected by its own key, not by Authelia (FLE-216). The identity headers above are still stripped.
{% else %}
        forward_auth {{ authelia }} {
            uri /api/authz/forward-auth
            copy_headers Remote-Groups
        }

        # Per-project access: the groups come from Authelia (the client's own header was stripped above).
        @forbidden not header_regexp Remote-Groups `{{ groups_pattern }}`
        respond @forbidden "Forbidden" 403
        request_header -Remote-Groups
{% endif %}

        reverse_proxy {{ router_host }}:{{ port.router }}
    }
}
{% endfor %}
{% endautoescape %}
