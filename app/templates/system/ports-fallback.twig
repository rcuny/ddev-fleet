{% autoescape false %}
# Generated by Fleet; edits are overwritten.
# An unknown host name on a named port answers 404, like 0.x, instead of Caddy's empty 200. One block per public port,
# in a file of its own: two instances of a project share the port, and the same site address twice is a Caddy error.
{% for port in public_ports %}

:{{ port }} {
    header {
        X-Robots-Tag "noindex, nofollow"
        -Server
    }

    respond "Not Found" 404
}
{% endfor %}
{% endautoescape %}
