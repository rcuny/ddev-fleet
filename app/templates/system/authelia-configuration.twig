{% autoescape false %}
# Generated by Fleet and installed by `apply authelia`; edits are overwritten. Secrets are supplied through
# AUTHELIA_*_FILE variables, never written here.
server:
  address: 'tcp://{{ address }}/'
log:
  level: info
authentication_backend:
  password_reset:
    disable: true
  file:
    path: '{{ users_file }}'
    watch: true
session:
  cookies:
    - domain: '{{ domain }}'
      authelia_url: 'https://auth.{{ domain }}'
storage:
  local:
    path: '{{ state_dir }}/db.sqlite3'
notifier:
  filesystem:
    filename: '{{ state_dir }}/notification.txt'
access_control:
  default_policy: deny
  rules:
    - domain: 'auth.{{ domain }}'
      policy: bypass
    - domain: '{{ domain }}'
      policy: one_factor
{% endautoescape %}
