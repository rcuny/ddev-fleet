{% autoescape false %}
# Generated by Fleet and installed by `apply authelia`; edits are overwritten. Secrets are supplied through
# AUTHELIA_*_FILE variables, never written here.
server:
  address: 'tcp://{{ address }}/'
log:
  level: info
authentication_backend:
  password_reset:
    disable: {{ reset_enabled ? 'false' : 'true' }}
  file:
    path: '{{ users_file }}'
    watch: true
  # Re-read the user's groups on every request, so a membership change applies at once (the file is small and local).
  refresh_interval: always
session:
  cookies:
    - domain: '{{ domain }}'
      authelia_url: 'https://auth.{{ domain }}'
storage:
  local:
    path: '{{ state_dir }}/db.sqlite3'
regulation:
  max_retries: {{ max_retries }}
  find_time: '{{ find_time }}'
  ban_time: '{{ ban_time }}'
notifier:
{% if smtp is not null %}
  smtp:
    address: '{{ smtp.address }}'
    sender: '{{ smtp.sender }}'
{% if smtp.username is not null %}
    username: '{{ smtp.username }}'
{% endif %}
{% else %}
  filesystem:
    filename: '{{ state_dir }}/notification.txt'
{% endif %}
access_control:
  default_policy: deny
  rules:
    - domain: 'auth.{{ domain }}'
      policy: bypass
    - domain: '{{ domain }}'
      policy: one_factor
    # Instance hosts: any signed-in user. Which project a user may open is checked by the instance's Caddy site from
    # the Remote-Groups header, so access changes never touch this file (and never restart Authelia).
    - domain: '*.{{ domain }}'
      policy: one_factor
{% endautoescape %}
