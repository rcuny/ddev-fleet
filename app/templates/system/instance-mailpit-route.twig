{% autoescape false %}
    # The instance's Mailpit: same sign-in and project check as the instance, then the router's Mailpit port. The Host is
    # the instance's own name (the router picks the project by it); websockets (/api/events) pass through the proxy.
    route {
{% for header in stripped_headers %}
        request_header -{{ header }}
{% endfor %}

        forward_auth {{ authelia }} {
            uri /api/authz/forward-auth
            copy_headers Remote-Groups
        }

        @forbidden_mp_{{ id }} not header_regexp Remote-Groups `{{ groups_pattern }}`
        respond @forbidden_mp_{{ id }} "Forbidden" 403
        request_header -Remote-Groups

        reverse_proxy {{ mailpit_router }} {
            header_up Host {{ mailpit.upstream_host }}
            header_up Authorization "{{ mailpit.authorization }}"
        }
    }
{% endautoescape %}
