{% extends 'setup/base.html.twig' %}

{% block setup_content %}
    <twig:Card>
        <twig:Card:Header>
            <h1>Domain and certificates</h1>
            <p>Fleet is served on <strong data-testid="setup-domain">{{ domain }}</strong>. The domain was set by the installer.</p>
        </twig:Card:Header>
        <twig:Card:Content>
            {{ form_start(form, {attr: {class: 'grid gap-4', 'data-testid': 'setup-tls-form'}}) }}
                {{ form_errors(form) }}
                {{ form_row(form.mode) }}
                <fieldset class="grid gap-4 rounded-lg border border-hairline p-3">
                    <legend class="px-1">OVH DNS credentials</legend>
                    <p class="text-xs text-ink-muted">Only used in DNS mode. Stored encrypted; never shown again.</p>
                    {{ form_row(form.ovhEndpoint) }}
                    {{ form_row(form.ovhApplicationKey) }}
                    {{ form_row(form.ovhApplicationSecret) }}
                    {{ form_row(form.ovhConsumerKey) }}
                </fieldset>
                {{ form_widget(form.save, {attr: {class: 'w-full md:w-auto'}}) }}
            {{ form_end(form) }}
        </twig:Card:Content>
    </twig:Card>
{% endblock %}
