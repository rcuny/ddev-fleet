{% extends 'base.html.twig' %}

{% block title %}Forbidden · {{ parent() }}{% endblock %}

{% block content %}
    {% if siteOnly|default(false) %}
        <twig:PageHeader title="Access denied" description="This account only opens project sites." />
        <p class="mt-6" data-testid="site-only-denied">This account only opens project sites. It cannot use Fleet itself: open the address of the site you were given.</p>
    {% else %}
        <twig:PageHeader title="Access denied" description="You do not have access to this page." />
        <p class="mt-6">Ask an administrator if you need it, or go back to a page you can open.</p>
        <twig:Button as="a" href="{{ path('home') }}" class="mt-4 h-11 md:h-8">Back to Home</twig:Button>
    {% endif %}
{% endblock %}
