{# symfony-design-system:start #}
{% set sample %}{% verbatim %}
<div class="space-y-8">
    {# Phone (below md): a full-width native select that names the active tab. #}
    <div class="max-w-sm border-b border-hairline py-2 md:hidden">
        <twig:NativeSelect aria-label="Section" class="w-full">
            <twig:NativeSelect:Option value="overview" selected>Overview</twig:NativeSelect:Option>
            <twig:NativeSelect:Option value="activity">Activity</twig:NativeSelect:Option>
            <twig:NativeSelect:Option value="members">Members</twig:NativeSelect:Option>
        </twig:NativeSelect>
    </div>

    {# md and up: tab strip with an optional right-hand slot. #}
    <nav aria-label="Section tabs" class="hidden items-end justify-between gap-4 border-b border-hairline md:flex">
        <div class="flex items-center gap-6">
            <a href="#sub-navigation" aria-current="page" class="-mb-px border-b-2 border-brand px-1 py-3 text-sm font-medium text-brand-darker hover:no-underline dark:text-brand">Overview</a>
            <a href="#sub-navigation" class="-mb-px border-b-2 border-transparent px-1 py-3 text-sm text-ink-body hover:text-ink-display hover:no-underline">Activity</a>
            <a href="#sub-navigation" class="-mb-px border-b-2 border-transparent px-1 py-3 text-sm text-ink-body hover:text-ink-display hover:no-underline">Members</a>
        </div>
        <div class="flex items-center gap-3 pb-2">
            <a href="#sub-navigation" class="text-sm text-ink-muted hover:text-ink-display">View all</a>
        </div>
    </nav>
</div>
{% endverbatim %}{% endset %}
<twig:Ds:Section id="sub-navigation" title="Sub navigation" :sample="sample|trim" :components="['NativeSelect']">
    <twig:block name="description">
        <p>
            A horizontal tab list for moving within one section of the app (settings pages, project tabs). The active tab's underline merges with the row's bottom hairline.
            Below <code>md</code> the strip becomes a full-width native select showing the active tab, so there is never horizontal scrolling or a wrapped row.
        </p>
    </twig:block>
    <twig:block name="when_to_use">
        <ul>
            <li>Three or more sibling sub-views with a stable structure.</li>
            <li>Appended to a page header (the "with tabs" variant).</li>
        </ul>
    </twig:block>
    <twig:block name="when_not_to_use">
        <ul>
            <li>One or two sub-pages: link them inline in the body.</li>
            <li>Top-level destinations: those belong in the main navigation.</li>
        </ul>
    </twig:block>
    <twig:block name="options">
        <ul>
            <li><strong>Active tab</strong>: <code>border-brand text-brand-darker dark:text-brand font-medium</code> plus <code>aria-current="page"</code>; <code>-mb-px</code> overlaps the parent hairline.</li>
            <li><strong>Right-hand slot</strong>: links, filters, small actions; <code>pb-2</code> centres them against the tab text.</li>
            <li><strong>Phone</strong>: the select navigates on change (a small Stimulus or Turbo handler), or submit it with a Go button when scripting is unwanted.</li>
        </ul>
    </twig:block>
</twig:Ds:Section>
{# symfony-design-system:end #}
