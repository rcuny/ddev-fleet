{% set form = forms.claude %}
{% set updated = secrets.claude %}
<twig:Card data-testid="host-tab-claude">
    <twig:Card:Header>
        <twig:Card:Title>Claude token</twig:Card:Title>
        <twig:Card:Description>Lets Claude Code run inside the instances. The token is stored encrypted and is never shown again.</twig:Card:Description>
    </twig:Card:Header>
    <twig:Card:Content class="grid gap-6">
        <p data-testid="host-claude-status" class="flex flex-wrap items-center gap-2">
            {% if updated is not null %}
                <twig:Badge class="border-transparent bg-brand-faded text-brand-darker dark:text-brand">Set</twig:Badge>
                <span class="text-sm text-ink-muted">Updated {{ updated|date('Y-m-d H:i', 'UTC') }} UTC</span>
            {% else %}
                <twig:Badge variant="secondary">Not set</twig:Badge>
            {% endif %}
        </p>
        {{ form_start(form, {attr: {class: 'grid gap-4', 'data-testid': 'host-claude-form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.token) }}
            {{ form_widget(form.save, {attr: {class: 'w-full md:w-auto'}}) }}
        {{ form_end(form) }}
    </twig:Card:Content>
</twig:Card>
