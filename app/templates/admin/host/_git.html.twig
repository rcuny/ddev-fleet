{% set form = forms.git %}
<twig:Card data-testid="host-tab-git">
    <twig:Card:Header>
        <twig:Card:Title>Git identity</twig:Card:Title>
        <twig:Card:Description>The default author of the commits the fleet makes in instances (the git bot).</twig:Card:Description>
    </twig:Card:Header>
    <twig:Card:Content>
        {{ form_start(form, {attr: {class: 'grid gap-4', 'data-testid': 'host-git-form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.email) }}
            {{ form_widget(form.save, {attr: {class: 'w-full md:w-auto'}}) }}
        {{ form_end(form) }}
    </twig:Card:Content>
</twig:Card>
