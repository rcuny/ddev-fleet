{#- Lists the managed secrets of one scope and lets an admin set, reveal and delete them. Needs: project (Project|null: null is the fleet-wide scope), overview (SecretOverview), revealed ({name, value}|null), form ({name}), errors (field => message). A value is never rendered here except in the reveal dialog. -#}
{% set scopeKey = project ? 'project' : 'fleet' %}
{% set nameAttrs = errors.name is defined ? {'aria-invalid': 'true', 'aria-describedby': 'secret-name-error'} : {} %}
{% set valueAttrs = errors.value is defined ? {'aria-invalid': 'true', 'aria-describedby': 'secret-value-error'} : {} %}
{% set putUrl = project ? path('project_secret_put', {name: project.name}) : path('secret_put') %}

{% if revealed %}
    <twig:Dialog id="reveal-secret" open>
        <twig:Dialog:Content data-testid="reveal-dialog">
            <twig:Dialog:Header>
                <twig:Dialog:Title class="font-mono [overflow-wrap:anywhere]">{{ revealed.name }}</twig:Dialog:Title>
                <twig:Dialog:Description>This is the only time the value is shown. The reveal was recorded in the audit log.</twig:Dialog:Description>
            </twig:Dialog:Header>
            <pre data-testid="revealed-value" class="max-h-64 overflow-auto rounded-md border border-hairline bg-surface p-3 text-sm whitespace-pre-wrap [overflow-wrap:anywhere]"><code>{{ revealed.value }}</code></pre>
            <twig:Dialog:Footer>
                <twig:Dialog:Close>
                    <twig:Button variant="outline" class="h-11 w-full md:h-8 md:w-auto" {{ ...dialog_close_attrs }}>Close</twig:Button>
                </twig:Dialog:Close>
            </twig:Dialog:Footer>
        </twig:Dialog:Content>
    </twig:Dialog>
{% endif %}

<section aria-labelledby="secrets-heading" class="grid gap-3" data-testid="secrets-list">
    <h2 id="secrets-heading">{{ project ? 'Project secrets' : 'Fleet-wide secrets' }}</h2>
    {% if overview.secrets|length == 0 %}
        <p class="rounded-md border border-hairline p-4 text-sm text-ink-muted" data-testid="secrets-empty">
            {{ project ? 'This project has no secrets yet.' : 'There are no fleet-wide secrets yet.' }}
        </p>
    {% else %}
        <ul class="divide-y divide-hairline overflow-hidden rounded-md border border-hairline bg-page">
            {% for secret in overview.secrets %}
                {% set referenced = overview.referenced(secret) %}
                <li data-testid="secret-row" data-secret="{{ secret.name }}" class="grid gap-3 px-4 py-3 md:grid-cols-[1fr_auto] md:items-center">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="font-mono text-sm font-medium text-ink-display [overflow-wrap:anywhere]" data-testid="secret-name">{{ secret.name }}</span>
                            {% if referenced is same as(false) %}
                                <twig:Badge data-testid="secret-no-placeholder" class="bg-signal-faded text-signal-darker dark:text-signal">No placeholder</twig:Badge>
                            {% endif %}
                        </div>
                        <p class="mt-1 text-xs text-ink-muted [overflow-wrap:anywhere]">
                            <code>{{ secret.placeholder }}</code> · set by {{ secret.updatedBy }} on {{ secret.updatedAt|date('Y-m-d H:i', 'UTC') }} UTC
                        </p>
                        {% if referenced is same as(false) %}
                            <p class="mt-1 text-xs text-ink-body" data-testid="secret-warning">No file in this project's assets mentions <code>{{ secret.placeholder }}</code>, so instances never receive this value.</p>
                        {% endif %}
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <form method="post" action="{{ project ? path('project_secret_reveal', {name: project.name, secret: secret.name}) : path('secret_reveal', {secret: secret.name}) }}" data-turbo="false" class="contents">
                            {{ include('setup/_csrf.html.twig') }}
                            <twig:Button type="submit" variant="outline" class="h-11 md:h-8" data-testid="secret-reveal">
                                <twig:ux:icon name="lucide:eye" />
                                Reveal
                            </twig:Button>
                        </form>
                        <twig:Button as="a" variant="outline" class="h-11 md:h-8" href="{{ (project ? path('project_secrets', {name: project.name}) : path('secrets')) ~ '?' ~ ({name: secret.name}|url_encode) ~ '#set-secret' }}" data-testid="secret-replace">Replace</twig:Button>
                        <twig:Dialog id="delete-secret-{{ loop.index }}">
                            <twig:Dialog:Trigger>
                                <twig:Button variant="destructive" class="h-11 md:h-8" data-testid="secret-delete" {{ ...dialog_trigger_attrs }}>Delete</twig:Button>
                            </twig:Dialog:Trigger>
                            <twig:Dialog:Content>
                                <twig:Dialog:Header>
                                    <twig:Dialog:Title class="font-mono [overflow-wrap:anywhere]">Delete {{ secret.name }}?</twig:Dialog:Title>
                                    <twig:Dialog:Description>Instances deployed later no longer receive this value. It cannot be recovered.</twig:Dialog:Description>
                                </twig:Dialog:Header>
                                <twig:Dialog:Footer>
                                    <twig:Dialog:Close>
                                        <twig:Button variant="outline" class="h-11 w-full md:h-8 md:w-auto" {{ ...dialog_close_attrs }}>Cancel</twig:Button>
                                    </twig:Dialog:Close>
                                    <form method="post" action="{{ project ? path('project_secret_delete', {name: project.name, secret: secret.name}) : path('secret_delete', {secret: secret.name}) }}" class="contents">
                                        {{ include('setup/_csrf.html.twig') }}
                                        <twig:Button type="submit" variant="destructive" class="h-11 w-full md:h-8 md:w-auto" data-testid="secret-delete-confirm">Delete secret</twig:Button>
                                    </form>
                                </twig:Dialog:Footer>
                            </twig:Dialog:Content>
                        </twig:Dialog>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    {% if project %}
        {% if overview.scan and not overview.scan.assetsDirExists or overview.scan and overview.scan.filesScanned == 0 %}
            <p class="text-sm text-ink-muted" data-testid="secrets-no-assets">No asset files yet, so placeholders cannot be checked. Add files that use a placeholder such as <code>[[my-token]]</code> in the project's assets.</p>
        {% elseif overview.scan and not overview.scan.complete %}
            <p class="text-sm text-ink-muted" data-testid="secrets-scan-partial">The assets directory is large: only the first {{ overview.scan.filesScanned }} text files were checked for placeholders.</p>
        {% endif %}
    {% endif %}
</section>

<section aria-labelledby="set-secret-heading" id="set-secret" class="grid gap-4" data-testid="secret-form-section">
    <h2 id="set-secret-heading">Add or replace a secret</h2>
    <p class="text-sm text-ink-body">
        Names are capital letters, digits and underscores (<code>JIRA_TOKEN</code>). An asset file receives the value where it writes the matching placeholder: <code>[[jira-token]]</code>.
        Values are stored encrypted and are never shown again; an admin can reveal one, and every reveal is recorded.
        {% if project %}A project secret wins over a fleet-wide secret of the same name.{% endif %}
    </p>
    <form method="post" action="{{ putUrl }}" novalidate autocomplete="off" class="grid gap-6" data-testid="secret-form">
        {{ include('setup/_csrf.html.twig') }}
        <div class="grid gap-2" data-slot="form-row">
            <twig:Label for="secret-name">Name</twig:Label>
            <twig:Input id="secret-name" name="name" value="{{ form.name }}" class="h-11 font-mono md:h-8" autocapitalize="characters" autocomplete="off" spellcheck="false" maxlength="64" {{ ...nameAttrs }} />
            {% if errors.name is defined %}<p id="secret-name-error" class="text-sm text-destructive" data-testid="error-name">{{ errors.name }}</p>{% endif %}
        </div>
        <div class="grid gap-2" data-slot="form-row">
            <twig:Label for="secret-value">Value</twig:Label>
            <twig:Textarea id="secret-value" name="value" rows="4" class="font-mono" autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" {{ ...valueAttrs }}></twig:Textarea>
            {% if errors.value is defined %}<p id="secret-value-error" class="text-sm text-destructive" data-testid="error-value">{{ errors.value }}</p>{% endif %}
        </div>
        <div class="flex flex-col gap-2 md:flex-row">
            <twig:Button type="submit" class="h-11 w-full md:h-8 md:w-auto" data-testid="secret-save">Save secret</twig:Button>
        </div>
    </form>
</section>
