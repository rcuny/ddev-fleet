{% extends 'base.html.twig' %}

{% block title %}Secrets · {{ parent() }}{% endblock %}

{% block content %}
    <twig:PageHeader title="Secrets" description="Credentials and tokens shared by every project. Project-specific ones live on each project's Secrets tab.">
        <twig:block name="actions">
            <twig:Button as="a" variant="outline" href="{{ path('audit') }}" class="h-11 md:h-8">Audit log</twig:Button>
        </twig:block>
    </twig:PageHeader>

    <div class="mt-6 grid max-w-2xl gap-8">
        {{ include('admin/secrets/_manage.html.twig', {project: null, overview: overview, revealed: revealed, form: form, errors: errors}) }}

        {% if hostSecrets|length > 0 %}
            <section aria-labelledby="host-secrets-heading" class="grid gap-3" data-testid="host-secrets">
                <h2 id="host-secrets-heading">Host secrets</h2>
                <p class="text-sm text-ink-body">Set by the setup wizard (DNS credentials, the Claude token). They are used by Fleet itself, never reach an instance, and are changed in the setup, not here.</p>
                <ul class="divide-y divide-hairline overflow-hidden rounded-md border border-hairline bg-page">
                    {% for secret in hostSecrets %}
                        <li data-testid="host-secret-row" class="px-4 py-2 text-sm">
                            <span class="font-mono text-ink-display [overflow-wrap:anywhere]">{{ secret.name }}</span>
                            <span class="block text-xs text-ink-muted">set by {{ secret.updatedBy }} on {{ secret.updatedAt|date('Y-m-d H:i', 'UTC') }} UTC</span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    </div>
{% endblock %}
