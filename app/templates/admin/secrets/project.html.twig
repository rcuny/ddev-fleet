{% extends 'base.html.twig' %}

{% block title %}Keys & secrets · {{ project.name }} · Projects · {{ parent() }}{% endblock %}

{% block content %}
    <twig:PageHeader :title="project.name" :description="project.git">
        <twig:block name="tabs">
            {{ include('admin/projects/_tabs.html.twig', {project: project, active: 'keys'}) }}
        </twig:block>
    </twig:PageHeader>

    <div class="mt-6 grid max-w-2xl gap-8">
        <section aria-labelledby="git-ssh-heading" class="grid gap-4" data-testid="git-ssh-section">
            <h2 id="git-ssh-heading">Git SSH</h2>
            <twig:Alert class="border-transparent bg-signal-faded text-signal-darker dark:text-signal" data-testid="container-ssh-risk">
                <twig:ux:icon name="lucide:triangle-alert" />
                <twig:Alert:Description class="text-ink-body">With this on, any process in the container can use the push key while the agent runs.</twig:Alert:Description>
            </twig:Alert>
            <p class="text-sm text-ink-body" data-testid="container-ssh-state">
                Git over SSH inside the container is <strong>{{ project.containerSsh ? 'on' : 'off' }}</strong> for this project: {{ project.containerSsh ? 'each instance starts a dedicated ssh-agent that holds the push key.' : 'instances do not get the push key.' }}
            </p>
            <twig:Dialog id="container-ssh-confirm">
                <twig:Dialog:Trigger>
                    <twig:Button type="button" variant="{{ project.containerSsh ? 'outline' : 'destructive' }}" class="h-11 w-full md:h-8 md:w-auto" data-testid="container-ssh-change" {{ ...dialog_trigger_attrs }}>{{ project.containerSsh ? 'Turn off' : 'Turn on' }}</twig:Button>
                </twig:Dialog:Trigger>
                <twig:Dialog:Content data-testid="container-ssh-dialog">
                    <twig:Dialog:Header>
                        <twig:Dialog:Title>{{ project.containerSsh ? 'Turn off Git over SSH?' : 'Turn on Git over SSH?' }}</twig:Dialog:Title>
                        <twig:Dialog:Description>{{ project.containerSsh ? 'New and restarted instances stop getting the push key. Templates that name extra SSH keys are refused until they are removed.' : 'Any process in the instance container can use the push key while the agent runs. Turn it on only for projects whose agents must push from the container. You are asked for your password again.' }}</twig:Dialog:Description>
                    </twig:Dialog:Header>
                    <twig:Dialog:Footer>
                        <twig:Dialog:Close>
                            <twig:Button variant="outline" class="h-11 w-full md:h-8 md:w-auto" {{ ...dialog_close_attrs }}>Cancel</twig:Button>
                        </twig:Dialog:Close>
                        <form method="post" action="{{ path('project_keys_ssh', {name: project.name}) }}" class="contents">
                            {{ include('setup/_csrf.html.twig') }}
                            <input type="hidden" name="container_ssh" value="{{ project.containerSsh ? '0' : '1' }}">
                            {% if not project.containerSsh %}<input type="hidden" name="confirm" value="1">{% endif %}
                            <twig:Button type="submit" variant="{{ project.containerSsh ? 'outline' : 'destructive' }}" class="h-11 w-full md:h-8 md:w-auto" data-testid="container-ssh-confirm-button">{{ project.containerSsh ? 'Turn off' : 'Turn on' }}</twig:Button>
                        </form>
                    </twig:Dialog:Footer>
                </twig:Dialog:Content>
            </twig:Dialog>

            <div data-testid="template-ssh-keys">
                <h3>Extra SSH keys per template</h3>
                <p class="text-sm text-ink-muted">Names only. Edit them in the template form; each name must match a key file already on the host.</p>
                <ul class="mt-2 divide-y divide-hairline rounded-md border border-hairline">
                    {% for template in templates %}
                        <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-2 text-sm" data-testid="template-ssh-row">
                            <a href="{{ path('template_edit', {name: project.name, template: template.name}) }}" class="font-medium">{{ template.name }}</a>
                            <span class="font-mono text-xs text-ink-body [overflow-wrap:anywhere]">{{ template.sshKeys ? template.sshKeys|join(', ') : 'none' }}{% if template.sshIdentities.value == 'extras_only' %} (no push key){% endif %}</span>
                        </li>
                    {% else %}
                        <li class="px-4 py-2 text-sm text-ink-muted">This project has no templates yet.</li>
                    {% endfor %}
                </ul>
            </div>
            <p class="text-sm text-ink-body">The deploy and push keys and the extra keys are host-level. See them, copy their public halves and manage the extras on the <a href="{{ path('settings_ssh_keys') }}" class="underline" data-testid="ssh-keys-link">SSH keys</a> page of the host settings.</p>
        </section>

        {{ include('admin/secrets/_manage.html.twig', {project: project, overview: overview, revealed: revealed, form: form, errors: errors}) }}
    </div>
{% endblock %}
