{% extends 'base.html.twig' %}

{% block title %}Secrets · {{ project.name }} · Projects · {{ parent() }}{% endblock %}

{% block content %}
    <twig:PageHeader :title="project.name" :description="project.git">
        <twig:block name="tabs">
            {{ include('admin/projects/_tabs.html.twig', {project: project, active: 'secrets'}) }}
        </twig:block>
    </twig:PageHeader>

    <div class="mt-6 grid max-w-2xl gap-8">
        {{ include('admin/secrets/_manage.html.twig', {project: project, overview: overview, revealed: revealed, form: form, errors: errors}) }}
    </div>
{% endblock %}
