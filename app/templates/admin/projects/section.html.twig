{% extends 'base.html.twig' %}

{#- A thin page for a tab whose content is still in another tab. Needs: project, active ('access' | 'capacity' | 'transfer'); capacity also gets allocatable and effectiveThreads. -#}
{% set titles = {access: 'Access', capacity: 'Capacity', transfer: 'Transfer & danger'} %}

{% block title %}{{ titles[active] }} · {{ project.name }} · Projects · {{ parent() }}{% endblock %}

{% block content %}
    <twig:PageHeader :title="project.name" :description="project.git">
        <twig:block name="tabs">
            {{ include('admin/projects/_tabs.html.twig', {project: project, active: active}) }}
        </twig:block>
    </twig:PageHeader>

    <div class="mt-6 grid max-w-2xl gap-4" data-testid="project-section-{{ active }}">
        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>{{ titles[active] }}</twig:Card:Title>
                {% if active == 'access' %}
                    <twig:Card:Description>Project members are set on each user's page for now. The port access (public or login) is shown on the Network tab.</twig:Card:Description>
                {% elseif active == 'capacity' %}
                    <twig:Card:Description>The project's CPU threads and slots are edited on the Source tab for now.</twig:Card:Description>
                {% else %}
                    <twig:Card:Description>Export and Delete are on the Source tab for now.</twig:Card:Description>
                {% endif %}
            </twig:Card:Header>
            <twig:Card:Content>
                {% if active == 'access' %}
                    <twig:Button as="a" variant="outline" href="{{ path('users') }}" class="h-11 md:h-8">Users</twig:Button>
                    <twig:Button as="a" variant="outline" href="{{ path('project_network', {name: project.name}) }}" class="h-11 md:h-8">Network</twig:Button>
                {% elseif active == 'capacity' %}
                    <p class="mb-4 text-sm" data-testid="capacity-effective">Effective: {{ effectiveThreads }} of {{ allocatable }} allocatable threads{{ project.cpuThreads is null ? ' (no project cap)' }}.</p>
                    <twig:Button as="a" variant="outline" href="{{ path('project_source', {name: project.name}) }}#project-capacity-fields" class="h-11 md:h-8">Edit on Source</twig:Button>
                {% else %}
                    <twig:Button as="a" variant="outline" href="{{ path('project_source', {name: project.name}) }}#danger-zone" class="h-11 md:h-8">Go to Source</twig:Button>
                {% endif %}
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
