{% extends 'base.html.twig' %}

{% set create = template is null %}
{% block title %}{{ create ? 'New template' : template.name }} · Templates · {{ project.name }} · Projects · {{ parent() }}{% endblock %}

{% block content %}
    <twig:PageHeader :title="project.name" :description="project.git">
        <twig:block name="tabs">
            {{ include('admin/projects/_tabs.html.twig', {project: project, active: 'templates'}) }}
        </twig:block>
    </twig:PageHeader>

    <div class="mt-6 grid max-w-2xl gap-8">
        <div class="grid gap-2">
            <a href="{{ path('project_templates', {name: project.name}) }}" class="inline-flex min-h-11 items-center gap-1 text-sm md:min-h-0">
                <twig:ux:icon name="lucide:arrow-left" class="size-4" />
                Templates
            </a>
            <h2 class="[overflow-wrap:anywhere]" data-testid="template-heading">
                {%- if create %}New template{% else %}Template <span class="font-mono">{{ template.name }}</span>{% endif -%}
            </h2>
        </div>

        {{ form_start(form, {attr: {class: 'grid gap-6'}}) }}
            {{ form_errors(form) }}
            {% if create %}
                {{ form_row(form.name) }}
            {% endif %}
            {{ form_row(form.drupalEnv) }}
            {{ form_row(form.postDeploy) }}
            {{ form_row(form.tty1) }}
            {{ form_row(form.tty2) }}

            <div class="flex flex-col gap-2 md:flex-row">
                {{ form_widget(form.save, {attr: {class: 'w-full md:w-auto'}}) }}
                <twig:Button as="a" href="{{ path('project_templates', {name: project.name}) }}" variant="outline" class="h-11 w-full md:h-8 md:w-auto">Cancel</twig:Button>
            </div>
        {{ form_end(form) }}

        {% if not create %}
            <twig:Card data-testid="danger-zone">
                <twig:Card:Header>
                    <twig:Card:Title>Danger zone</twig:Card:Title>
                    <twig:Card:Description>Instances already deployed from this template keep what they were given. The default template of a project cannot be deleted: choose another default first.</twig:Card:Description>
                </twig:Card:Header>
                <twig:Card:Content>
                    <twig:Dialog id="delete-template">
                        <twig:Dialog:Trigger>
                            <twig:Button variant="destructive" class="h-11 w-full md:h-8 md:w-auto" {{ ...dialog_trigger_attrs }}>Delete this template</twig:Button>
                        </twig:Dialog:Trigger>
                        <twig:Dialog:Content>
                            <twig:Dialog:Header>
                                <twig:Dialog:Title>Delete {{ template.name }}?</twig:Dialog:Title>
                                <twig:Dialog:Description>This removes the template from {{ project.name }}. It cannot be undone.</twig:Dialog:Description>
                            </twig:Dialog:Header>
                            <twig:Dialog:Footer>
                                <twig:Dialog:Close>
                                    <twig:Button variant="outline" class="h-11 w-full md:h-8 md:w-auto" {{ ...dialog_close_attrs }}>Cancel</twig:Button>
                                </twig:Dialog:Close>
                                <form method="post" action="{{ path('template_delete', {name: project.name, template: template.name}) }}" class="contents">
                                    {{ include('setup/_csrf.html.twig') }}
                                    <twig:Button type="submit" variant="destructive" class="h-11 w-full md:h-8 md:w-auto">Delete template</twig:Button>
                                </form>
                            </twig:Dialog:Footer>
                        </twig:Dialog:Content>
                    </twig:Dialog>
                </twig:Card:Content>
            </twig:Card>
        {% endif %}
    </div>
{% endblock %}
