{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} · Projects · {{ parent() }}{% endblock %}

{% block content %}
    <twig:PageHeader :title="project.name" :description="project.git">
        <twig:block name="tabs">
            {{ include('admin/projects/_tabs.html.twig', {project: project, active: 'source'}) }}
        </twig:block>
    </twig:PageHeader>

    <div class="mt-6 grid max-w-2xl gap-8">
        {{ include('admin/projects/_form.html.twig', {form: form, create: false}) }}

        <twig:IssueIdPreview :pattern="project.issueIdRegexp ?? ''" />
    </div>
{% endblock %}
