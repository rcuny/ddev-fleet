{#- The project's sections. Needs: project, active ('general' | 'templates' | 'ports'). Tab strip from md up, a select below it. -#}
{% set sections = [
    {key: 'general', label: 'General', url: path('project_edit', {name: project.name})},
    {key: 'templates', label: 'Templates', url: '/admin/projects/' ~ project.name ~ '/templates'},
    {key: 'ports', label: 'Ports', url: path('project_ports', {name: project.name})},
] %}
<div class="border-b border-hairline py-2 md:hidden">
    <twig:NativeSelect aria-label="Section" class="w-full" data-controller="select-nav" data-action="change->select-nav#go">
        {% for section in sections %}
            <twig:NativeSelect:Option value="{{ section.url }}" :selected="section.key == active">{{ section.label }}</twig:NativeSelect:Option>
        {% endfor %}
    </twig:NativeSelect>
</div>
<nav aria-label="Project sections" class="hidden items-center gap-6 border-b border-hairline md:flex">
    {% for section in sections %}
        {% if section.key == active %}
            <a href="{{ section.url }}" aria-current="page" class="-mb-px border-b-2 border-brand px-1 py-3 text-sm font-medium text-brand-darker hover:no-underline dark:text-brand">{{ section.label }}</a>
        {% else %}
            <a href="{{ section.url }}" class="-mb-px border-b-2 border-transparent px-1 py-3 text-sm text-ink-body hover:text-ink-display hover:no-underline">{{ section.label }}</a>
        {% endif %}
    {% endfor %}
</nav>
