{#- The project fields, in sections: the Source tab's (repository, git identity, issue ids) and, until they move to their own tab, the other settings. Needs: form, create (bool). -#}
{{ form_start(form, {attr: {class: 'grid gap-6'}}) }}
    {{ form_errors(form) }}
    <section class="grid gap-6" aria-labelledby="project-repository-heading" data-testid="source-repository">
        <h2 id="project-repository-heading" class="text-base">Repository</h2>
        {% if create %}
            {{ form_row(form.name) }}
        {% endif %}
        {{ form_row(form.git) }}
        {{ form_row(form.defaultBranch) }}
        {{ form_row(form.displaySubmoduleBranch) }}
    </section>

    <twig:Separator />

    <section class="grid gap-6" aria-labelledby="project-identity-heading" data-testid="source-identity">
        <h2 id="project-identity-heading" class="text-base">Git identity</h2>
        {{ form_row(form.gitBotMode) }}
        <div class="grid gap-6 md:grid-cols-2">
            {{ form_row(form.gitBotName) }}
            {{ form_row(form.gitBotEmail) }}
        </div>
    </section>

    <twig:Separator />

    <section class="grid gap-6" aria-labelledby="project-issue-heading" data-testid="source-issue-id">
        <h2 id="project-issue-heading" class="text-base">Issue ids</h2>
        {{ form_row(form.issueIdRegexp) }}
    </section>

    <twig:Separator />

    {#- Not moved yet: Network (hostnames, Typesense), Keys (container SSH) and Capacity get their own tabs in later tickets. -#}
    <section class="grid gap-6" aria-labelledby="project-other-heading" data-testid="source-other">
        <h2 id="project-other-heading" class="text-base">Other settings</h2>
        {{ form_row(form.additionalHostnames) }}
        {{ form_row(form.typesense) }}
        {{ form_row(form.containerSsh) }}
        <div class="grid gap-6 md:grid-cols-2" data-testid="project-capacity-fields">
            {{ form_row(form.cpuThreads) }}
            {{ form_row(form.slots) }}
        </div>
    </section>

    <div class="flex flex-col gap-2 md:flex-row">
        {{ form_widget(form.save, {attr: {class: 'w-full md:w-auto'}}) }}
        {% if create %}
            <twig:Button as="a" href="{{ path('projects') }}" variant="outline" class="h-11 w-full md:h-8 md:w-auto">Cancel</twig:Button>
        {% endif %}
    </div>
{{ form_end(form) }}
