{#- The General tab's fields. Needs: form, create (bool). -#}
{{ form_start(form, {attr: {class: 'grid gap-6'}}) }}
    {{ form_errors(form) }}
    {% if create %}
        {{ form_row(form.name) }}
    {% endif %}
    {{ form_row(form.git) }}
    {{ form_row(form.defaultBranch) }}
    {% if not create %}
        {{ form_row(form.defaultTemplate) }}
    {% endif %}
    {{ form_row(form.additionalHostnames) }}

    <twig:Separator />

    {{ form_row(form.gitBotMode) }}
    <div class="grid gap-6 md:grid-cols-2">
        {{ form_row(form.gitBotName) }}
        {{ form_row(form.gitBotEmail) }}
    </div>

    <twig:Separator />

    {{ form_row(form.issueIdRegexp) }}
    {{ form_row(form.displaySubmoduleBranch) }}
    {{ form_row(form.typesense) }}

    <div class="flex flex-col gap-2 md:flex-row">
        {{ form_widget(form.save, {attr: {class: 'w-full md:w-auto'}}) }}
        {% if create %}
            <twig:Button as="a" href="{{ path('projects') }}" variant="outline" class="h-11 w-full md:h-8 md:w-auto">Cancel</twig:Button>
        {% endif %}
    </div>
{{ form_end(form) }}
