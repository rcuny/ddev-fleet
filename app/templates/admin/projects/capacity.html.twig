{% extends 'base.html.twig' %}

{% block title %}Capacity · {{ project.name }} · Projects · {{ parent() }}{% endblock %}

{% block content %}
    <twig:PageHeader :title="project.name" :description="project.git">
        <twig:block name="tabs">
            {{ include('admin/projects/_tabs.html.twig', {project: project, active: 'capacity'}) }}
        </twig:block>
    </twig:PageHeader>

    <div class="mt-6 grid max-w-2xl gap-4" data-testid="project-section-capacity">
        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Capacity</twig:Card:Title>
                <twig:Card:Description>The project's CPU threads and slots are edited on the Source tab for now.</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                <p class="mb-4 text-sm" data-testid="capacity-effective">Effective: {{ effectiveThreads }} of {{ allocatable }} allocatable threads{{ project.cpuThreads is null ? ' (no project cap)' }}.</p>
                <twig:Button as="a" variant="outline" href="{{ path('project_source', {name: project.name}) }}#project-capacity-fields" class="h-11 md:h-8">Edit on Source</twig:Button>
            </twig:Card:Content>
        </twig:Card>
    </div>
{% endblock %}
