{% extends 'base.html.twig' %}

{% block title %}Webhook secret · {{ project.name }} · {{ parent() }}{% endblock %}

{% block content %}
    <twig:PageHeader title="Webhook secret" :description="source.label ~ ' · ' ~ project.name" />

    <div class="mt-6 grid max-w-2xl gap-6">
        <twig:Alert class="border-transparent bg-signal-faded text-signal-darker dark:text-signal" data-testid="webhook-secret-once">
            <twig:Alert:Title>Copy the secret now</twig:Alert:Title>
            <twig:Alert:Description class="text-ink-body">This is the only time it is shown. Paste it into the {{ source.label }} webhook's Secret field. Any earlier secret for this webhook no longer works.</twig:Alert:Description>
        </twig:Alert>

        <div class="grid gap-2" data-controller="clipboard">
            <twig:Label for="webhook-secret">Secret</twig:Label>
            <div class="flex gap-2">
                <twig:Input id="webhook-secret" readonly value="{{ secret }}" data-clipboard-target="source" data-testid="webhook-secret-value" autocomplete="off" class="h-11 min-w-0 flex-1 font-mono text-xs md:h-8" />
                <twig:Button variant="outline" data-action="clipboard#copy" class="h-11 md:h-8" data-testid="webhook-secret-copy">Copy</twig:Button>
            </div>
            <p class="text-xs text-ink-muted"><span data-clipboard-target="status" aria-live="polite" class="text-brand-darker dark:text-brand"></span></p>
        </div>

        <div class="grid gap-2" data-controller="clipboard">
            <twig:Label for="webhook-secret-url">Address</twig:Label>
            <div class="flex gap-2">
                <twig:Input id="webhook-secret-url" readonly value="{{ url }}" data-clipboard-target="source" class="h-11 min-w-0 flex-1 font-mono text-xs md:h-8" />
                <twig:Button variant="outline" data-action="clipboard#copy" class="h-11 md:h-8">Copy</twig:Button>
            </div>
            <p class="text-xs text-ink-muted"><span data-clipboard-target="status" aria-live="polite" class="text-brand-darker dark:text-brand"></span></p>
        </div>

        <div>
            <twig:Button as="a" href="{{ path('project_webhooks', {name: project.name}) }}" class="h-11 md:h-8" data-testid="webhook-secret-done">Done</twig:Button>
        </div>
    </div>
{% endblock %}
