{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platform": "bitbucket",
  "onboarding": false,
  "requireConfig": "optional",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "groupName": "security fixes"
  },
  "rangeStrategy": "bump",
  "commitMessagePrefix": "FLE-10",
  "packageRules": [
    {
      "description": "Python runtime dependencies: one grouped PR for minor/patch (pyproject.toml is extracted by the poetry and/or pep621 manager, so match on datasource + depType)",
      "matchDatasources": [
        "pypi"
      ],
      "matchDepTypes": [
        "project.dependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "python runtime"
    },
    {
      "description": "Dev/infra extras and build backend: one grouped PR",
      "matchDatasources": [
        "pypi"
      ],
      "matchDepTypes": [
        "project.optional-dependencies",
        "build-system.requires"
      ],
      "groupName": "python tooling"
    },
    {
      "description": "GitHub Actions: one grouped PR, tags not digest-pinned",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "pinDigests": false
    },
    {
      "description": "Ansible Galaxy collections: one grouped PR",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "groupName": "ansible collections"
    },
    {
      "description": "The Python interpreter version is a deliberate decision: never auto-bump the python docker image (pipelines) or setup-python's python-version (github-releases datasource)",
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Same for the requires-python floor in pyproject.toml",
      "matchManagers": [
        "pep621",
        "poetry"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Vendored htmx: Renovate bumps the version in docs/vendored-assets.md, a human re-downloads the file",
      "managerFilePatterns": [
        "/^docs/vendored-assets\\.md$/"
      ],
      "matchStrings": [
        "\\|\\s*htmx\\.min\\.js\\s*\\|\\s*htmx\\.org\\s*\\|\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*\\|"
      ],
      "depNameTemplate": "htmx.org",
      "datasourceTemplate": "npm"
    }
  ]
}
