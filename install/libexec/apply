#!/bin/bash
# Root helper of ddev-fleet: installs config that the app has rendered into its staging directory.
#
#   sudo -n /usr/local/libexec/fleet/apply <caddy|authelia|slices>
#
# Installed by install/steps/90-privileged.sh as root:root 0755, reachable by the `fleet` user through one sudoers
# line (install/etc/sudoers-fleet-apply). The only input is the target name; the files come from a fixed place,
# /srv/fleet/staging/<target>/. The helper:
#   - pins the staging directory once: it is opened, and the opened directory must be the real
#     /srv/fleet/staging/<target> (no symlink at any component), owned by fleet and not writable by anyone else; every
#     later access goes through that descriptor, and cleanup removes only the known file names inside it;
#   - opens every staged file once, read-only (a FIFO is refused before, a watchdog ends a run that one blocks) and checks the opened file (regular, one link, owned by
#     fleet, <= 256 KiB), then copies from that descriptor into a root-owned temporary directory, so the file cannot
#     change between the check and the copy; validation and installation use that copy only;
#   - never sources anything: the Caddy environment file is parsed line by line against an allowlist of keys and a
#     value charset, and the validators get it through `env -i`;
#   - validates the COPY with the real validator, as the service's own user, before anything is installed; secrets reach
#     the validator through a file it reads itself, never through argv (any local user can read /proc/*/cmdline);
#   - runs one at a time (flock);
#   - installs atomically (temp file + rename), reloads, and puts the previous files back when the reload fails; when the
#     Caddy environment file (the proxy secret) changed it restarts Caddy instead (deferred by 3 s: Caddy reads its
#     environment only at start);
#   - splits the staged environment file: the OVH credentials never go into Caddy's environment, they are written one
#     value per file to /etc/caddy/ovh/ (root:caddy 0750, files root:caddy 0640), which the Caddyfile reads through
#     {file.*} placeholders, so a rotation needs only a reload. The endpoint is no secret and sits in the Caddyfile. /etc/caddy/fleet.env keeps the proxy secret alone, and
#     any OVH_* line an older apply left there is dropped;
#   - deletes the staged files on every exit path (the staged environment file holds the OVH credentials).
# `apply authelia` with no staged configuration only restarts Authelia (the password-reset path).
# `apply slices` (capacity allotments) differs in kind: the staged slices.json is DATA ([{unit, quota_percent|null}]),
# never config text. The helper validates every unit name (^fleet(-[a-z0-9_]+){0,2}\.slice$, parents listed, no
# duplicates) and every quota (an integer 100..threads*100, threads from `nproc --all`) and then GENERATES the unit
# files and drop-ins itself: nothing of the staged file is copied into /etc. It writes /etc/systemd/system/<unit>
# (carrying an ownership marker line) and <unit>.d/10-fleet-quota.conf, removes the fleet*.slice units it owns (marker)
# that are no longer listed, runs daemon-reload, STARTS every slice (parents first: a missing slice would silently give
# containers no limit) and applies every quota to the running slice with `systemctl set-property --runtime` (a drop-in
# plus daemon-reload does not change a live cpu.max). A failure puts the previous files back and re-applies the previous
# quotas.
#
# Threat model, honestly: `fleet` is in the `docker` group, which is root-equivalent anyway. This helper keeps a
# half-written or invalid config from reaching Caddy or Authelia; it is not a security boundary.
#
# Exit codes: 0 ok, 1 failed (previous config restored where there was one), 64 usage, 65 staged data refused,
# 66 nothing staged, 75 another apply is running, 77 not root. Output never contains a staged value.
set -euo pipefail

# The only targets. A repo test keeps this word list equal to App\Fleet\System\ApplyTarget and to the sudoers line.
ALLOWED_TARGETS='caddy authelia slices'
readonly ALLOWED_TARGETS
readonly MAX_BYTES=262144
readonly CADDY_ENV_KEYS='FLEET_PROXY_SECRET OVH_APPLICATION_KEY OVH_APPLICATION_SECRET OVH_CONSUMER_KEY'
# Staged OVH key => file name under /etc/caddy/ovh/. The Caddyfile template names the same files (CaddyfileRenderer::OVH_DIR).
# The endpoint is not a secret: it is written into the Caddyfile (FLE-109). OVH_LEGACY_FILES are removed if an older apply left them.
readonly OVH_LEGACY_FILES='endpoint'
readonly OVH_FILES='OVH_APPLICATION_KEY:application_key OVH_APPLICATION_SECRET:application_secret OVH_CONSUMER_KEY:consumer_key'
# Secret files of the Authelia unit drop-in (install/etc/authelia-secrets.conf); `authelia config validate` needs them.
readonly AUTHELIA_SECRET_FILES='AUTHELIA_SESSION_SECRET_FILE=/etc/authelia/secrets/session_secret AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=/etc/authelia/secrets/storage_encryption_key AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=/etc/authelia/secrets/reset_password_jwt_secret'
# Budget: the app gives one apply 60 s, lock wait included. Caddy: lock 5 + validate 15 + reload 15 + rollback reload
# 15 = 50; authelia: lock 5 + validate 15 + restart 20 + rollback restart 20 = 60.
readonly T_LOCK=5 T_VALIDATE=15 T_RELOAD=15 T_RESTART=20 T_OPEN=5
# slices: lock 5 + jq + daemon-reloads + per-slice systemctl calls (T_SLICE each, MAX_SLICES at most, normally
# milliseconds) must stay inside the app's 60 s.
readonly T_SLICE=5 MAX_SLICES=500 SLICE_MAX_NAME=200
readonly SLICE_MARK='# Managed by ddev-fleet (apply slices). Hand edits are overwritten.'
readonly SLICE_UNIT_RE='^fleet(-[a-z0-9_]+){0,2}\.slice$'
readonly SLICE_DROPIN=10-fleet-quota.conf

umask 077
IFS=$' \t\n'
unset BASH_ENV ENV CDPATH GLOBIGNORE
export LC_ALL=C
# A fixed PATH for everything; only an unprivileged test run (below) gets its caller's PATH back, for its stubs.
CALLER_PATH=$PATH
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

fail() {
  printf 'apply: %s\n' "$1" >&2
  exit "${2:-1}"
}

# --- 1. arguments: exactly one known target -------------------------------------------------------------------
[ "$#" -eq 1 ] || fail 'usage: apply <caddy|authelia|slices>' 64
TARGET=$1
case " $ALLOWED_TARGETS " in
  *" $TARGET "*) ;;
  *) fail 'unknown target (usage: apply <caddy|authelia|slices>)' 64 ;;
esac

# --- 2. who may run this, and where the files are ---------------------------------------------------------------
# Root runs on the real paths and reads NO environment variable. Only an unprivileged run (the unit tests) may
# redirect everything into a scratch directory with FLEET_APPLY_TEST_ROOT; it can then install nothing real.
if [ "$EUID" -eq 0 ]; then
  ROOT=''
  REAL_ROOT=''
  AS_ROOT=1
  STAGING_OWNER=fleet
  WORK_PARENT=/run
else
  [ -n "${FLEET_APPLY_TEST_ROOT:-}" ] || fail 'must run as root (sudo -n /usr/local/libexec/fleet/apply <target>)' 77
  if [ ! -d "$FLEET_APPLY_TEST_ROOT" ] || [[ $FLEET_APPLY_TEST_ROOT != /* ]]; then
    fail 'FLEET_APPLY_TEST_ROOT must be an existing absolute directory' 77
  fi
  PATH=$CALLER_PATH
  export PATH
  ROOT=${FLEET_APPLY_TEST_ROOT%/}
  REAL_ROOT=$(realpath -e -- "$ROOT") || fail 'cannot resolve FLEET_APPLY_TEST_ROOT' 77
  AS_ROOT=0
  STAGING_OWNER=$(id -un)
  WORK_PARENT=$ROOT
fi
readonly ROOT REAL_ROOT AS_ROOT STAGING_OWNER WORK_PARENT

STAGE="$ROOT/srv/fleet/staging/$TARGET"
# What the staging directory must really be once opened (no symlink at any component).
# Only the /srv component is resolved: /srv may legitimately be a symlink (a data disk), the literal path below it
# (fleet/staging/<target>) may not.
SRV_REAL=$(realpath -e -- "$ROOT/srv" 2>/dev/null) || SRV_REAL="$REAL_ROOT/srv"
STAGE_EXPECTED="$SRV_REAL/fleet/staging/$TARGET"
CADDYFILE="$ROOT/etc/caddy/Caddyfile"
CADDY_ENV="$ROOT/etc/caddy/fleet.env"
CADDY_OVH_DIR="$ROOT/etc/caddy/ovh"
AUTHELIA_CONFIG="$ROOT/etc/authelia/configuration.yml"
SYSTEMD_UNIT_DIR="$ROOT/etc/systemd/system"
LOCK="$WORK_PARENT/fleet-apply.lock"
readonly SRV_REAL STAGE STAGE_EXPECTED CADDYFILE CADDY_ENV CADDY_OVH_DIR AUTHELIA_CONFIG SYSTEMD_UNIT_DIR LOCK

# The file names each target consumes; cleanup removes exactly these from the pinned directory.
case $TARGET in
  caddy) STAGED_NAMES='Caddyfile env' ;;
  authelia) STAGED_NAMES='configuration.yml' ;;
  slices) STAGED_NAMES='slices.json' ;;
esac
readonly STAGED_NAMES

# One apply at a time: two runs would interleave their rollbacks and the first one's cleanup would eat the files the
# second has not read yet.
exec 9>"$LOCK"
flock -w "$T_LOCK" 9 || fail 'another apply is running' 75

# PRIV (0700, root) holds the copies of the staged files and everything installed comes from there. PUB (0755) holds
# what the validator user must read: its own copy of the config, the environment file (readable by that user only) and
# its throw-away HOME. Neither contains anything the app can write.
PRIV=$(mktemp -d "$WORK_PARENT/fleet-apply.XXXXXX")
PUB=$(mktemp -d "$WORK_PARENT/fleet-apply-pub.XXXXXX")
chmod 0755 "$PUB"
readonly PRIV PUB

STAGE_PINNED=0
# Consumed or not, successful or not: the staged files this target uses are deleted (by name, through the pinned
# directory), and both temporary directories go.
cleanup() {
  local status=$? name
  trap - EXIT
  if [ "$STAGE_PINNED" -eq 1 ]; then
    for name in $STAGED_NAMES; do
      rm -f -- "/proc/self/fd/4/$name" 2>/dev/null || true
    done
  fi
  rm -rf -- "$PRIV" "$PUB"
  exit "$status"
}
trap cleanup EXIT

# --- 3. the staging directory, pinned once ---------------------------------------------------------------------

# pin_staging: opens the staging directory on descriptor 4 and proves it is the real, fleet-owned directory. Returns 1
# when there is no staging directory at all (nothing staged). Every later access goes through /proc/self/fd/4, so
# replacing a path component afterwards (fleet owns /srv/fleet) cannot redirect anything.
pin_staging() {
  local real facts type owner mode
  if [ ! -e "$STAGE" ] && [ ! -L "$STAGE" ]; then
    return 1
  fi
  [ -d "$STAGE" ] || fail 'the staging path is not a directory' 65
  exec 4<"$STAGE" || fail 'cannot open the staging directory' 65
  real=$(readlink -f -- /proc/self/fd/4) || fail 'cannot resolve the staging directory' 65
  [ "$real" = "$STAGE_EXPECTED" ] || fail 'the staging directory is not the expected real directory (a symlink in its path?)' 65
  facts=$(stat -L -c '%F|%U|%a' -- /proc/self/fd/4) || fail 'cannot inspect the staging directory' 65
  IFS='|' read -r type owner mode <<<"$facts"
  [ "$type" = directory ] || fail 'the staging path is not a directory' 65
  [ "$owner" = "$STAGING_OWNER" ] || fail "the staging directory is not owned by $STAGING_OWNER" 65
  if [ $((8#$mode & 8#022)) -ne 0 ]; then
    fail 'the staging directory is writable by group or others' 65
  fi
  STAGE_PINNED=1
}

# --- 4. reading staged files ------------------------------------------------------------------------------------

# stage_in <name> <dest>: copies the staged file <name> to <dest>. Returns 1 when it does not exist; refuses anything
# unsafe. The checks are made on the opened descriptor, the copy is read from it. Called under `||`/`if`, where errexit
# is off, so every command is checked by hand.
stage_in() {
  local src="/proc/self/fd/4/$1" dest=$2 watchdog path_id fd_id facts type owner links size copied
  [ "$STAGE_PINNED" -eq 1 ] || return 1
  if [ -L "$src" ]; then
    fail "staged file $1 is a symlink" 65
  fi
  [ -e "$src" ] || return 1
  # Refuse a FIFO first. The file is opened read-only (a read-write open of a device node swapped in after the checks
  # could do harm); a FIFO swapped in during that instant would block the open, so a watchdog ends the run (the
  # cleanup trap still runs) instead of letting it hang with the lock held.
  [ ! -p "$src" ] || fail "staged file $1 is not a regular file" 65
  [ -f "$src" ] || fail "staged file $1 is not a regular file" 65
  ( sleep "$T_OPEN" && kill -TERM "$$" ) 2>/dev/null 4<&- 9<&- &
  watchdog=$!
  exec 3<"$src" || fail "cannot open staged file $1" 65
  kill "$watchdog" 2>/dev/null || true
  path_id=$(stat -c '%d:%i' -- "$src") || fail "cannot inspect staged file $1" 65
  fd_id=$(stat -L -c '%d:%i' -- /proc/self/fd/3) || fail "cannot inspect staged file $1" 65
  [ "$path_id" = "$fd_id" ] || fail "staged file $1 changed while it was being opened" 65
  facts=$(stat -L -c '%F|%U|%h|%s' -- /proc/self/fd/3) || fail "cannot inspect staged file $1" 65
  IFS='|' read -r type owner links size <<<"$facts"
  case $type in
    'regular file' | 'regular empty file') ;;
    *) fail "staged file $1 is not a regular file" 65 ;;
  esac
  [ "$owner" = "$STAGING_OWNER" ] || fail "staged file $1 is not owned by $STAGING_OWNER" 65
  [ "$links" = 1 ] || fail "staged file $1 has more than one hard link" 65
  [ "$size" -le "$MAX_BYTES" ] || fail "staged file $1 is larger than $MAX_BYTES bytes" 65
  [ "$size" -gt 0 ] || fail "staged file $1 is empty" 65
  # Read at most MAX_BYTES+1 from the descriptor: a file that grows after the check is still refused.
  head -c $((MAX_BYTES + 1)) <&3 >"$dest" || fail "cannot copy staged file $1" 65
  exec 3<&-
  copied=$(stat -c %s -- "$dest") || fail "cannot inspect the copy of staged file $1" 65
  [ "$copied" -le "$MAX_BYTES" ] || fail "staged file $1 is larger than $MAX_BYTES bytes" 65
  return 0
}

# parse_caddy_env <file>: validates the staged environment file and writes the canonical form to <file>.canon.
# Only KEY=VALUE lines of known keys, each once, with a value of [A-Za-z0-9._~+/=-]. Never sourced, never echoed.
parse_caddy_env() {
  local file=$1 line key value secret n=0 have_ovh=0 k
  local -A seen=()
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    [ -n "$line" ] || continue
    if ! [[ $line =~ ^([A-Z][A-Z_]*)=([A-Za-z0-9._~+/=-]{1,256})$ ]]; then
      fail "the staged environment file has an unacceptable line ($n)" 65
    fi
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2]}
    case " $CADDY_ENV_KEYS " in
      *" $key "*) ;;
      *) fail "the staged environment file has an unknown key on line $n" 65 ;;
    esac
    [ -z "${seen[$key]:-}" ] || fail "the staged environment file repeats a key (line $n)" 65
    seen[$key]=$value
  done <"$file"

  secret=${seen[FLEET_PROXY_SECRET]:-}
  if [ "${#secret}" -lt 32 ]; then
    fail 'FLEET_PROXY_SECRET is missing or shorter than 32 characters' 65
  fi
  for k in OVH_APPLICATION_KEY OVH_APPLICATION_SECRET OVH_CONSUMER_KEY; do
    [ -z "${seen[$k]:-}" ] || have_ovh=$((have_ovh + 1))
  done
  if [ "$have_ovh" -ne 0 ] && [ "$have_ovh" -ne 3 ]; then
    fail 'the OVH credentials must be all present (application key, secret, consumer key) or all absent' 65
  fi
  # Caddy's environment gets the proxy secret only; each OVH value goes to its own file (no key, no newline games).
  printf 'FLEET_PROXY_SECRET=%s\n' "$secret" >"$file.canon"
  mkdir -p "$file.ovh"
  if [ "$have_ovh" -eq 3 ]; then
    local pair
    for pair in $OVH_FILES; do
      printf '%s\n' "${seen[${pair%%:*}]}" >"$file.ovh/${pair#*:}"
    done
  fi
}

# --- 5. running validators and installing -----------------------------------------------------------------------

# validator_run <user> <timeout> <envfile|-> <non-secret assignment>... -- <command>...
# Runs with an empty environment plus the assignments, a throw-away HOME, and (when an environment file is given) the
# KEY=VALUE lines of that file, which the child shell reads itself: a secret never appears in any argv. As `user` when
# root. The staging directory (fd 4), the staged file (3) and the lock (9) are closed in the child: it must not
# hold the lock after the helper has gone, nor reach the pinned directory. Only the values already validated by parse_caddy_env ever reach the `export` of the child.
validator_run() {
  local user=$1 limit=$2 envfile=$3 assignments=() cmd=() base
  shift 3
  while [ "$#" -gt 0 ] && [ "$1" != -- ]; do
    assignments+=("$1")
    shift
  done
  shift
  cmd=("$@")
  [ "$envfile" != - ] || envfile=/dev/null
  mkdir -p "$PUB/home"
  base=(env -i "PATH=$PATH" "HOME=$PUB/home" "XDG_CONFIG_HOME=$PUB/home" "XDG_DATA_HOME=$PUB/home" "${assignments[@]}")
  # shellcheck disable=SC2016  # single-quoted on purpose: the child shell expands $l, $1 and "$@"
  local loader='while IFS= read -r l || [ -n "$l" ]; do export "$l"; done <"$1"; shift; exec "$@"'
  if [ "$AS_ROOT" -eq 1 ] && [ "$user" != root ]; then
    chown "$user" "$PUB/home"
    timeout "$limit" runuser -u "$user" -- "${base[@]}" /bin/bash -c "$loader" validator "$envfile" "${cmd[@]}" </dev/null 3<&- 4<&- 9<&-
  else
    timeout "$limit" "${base[@]}" /bin/bash -c "$loader" validator "$envfile" "${cmd[@]}" </dev/null 3<&- 4<&- 9<&-
  fi
}

# put_file <src> <dest> <mode> <owner> <group>: atomic install; ownership is only set when root. Returns 1 (and leaves
# no temp file) when any step fails, e.g. a full disk.
put_file() {
  local src=$1 dest=$2 mode=$3 owner=$4 group=$5 tmp
  tmp=$(mktemp "$dest.XXXXXX") || return 1
  if cat -- "$src" >"$tmp" && chmod "$mode" "$tmp" && { [ "$AS_ROOT" -eq 0 ] || chown "$owner:$group" "$tmp"; } && mv -f -- "$tmp" "$dest"; then
    return 0
  fi
  rm -f -- "$tmp"
  return 1
}

# keep_previous <live file> <name>: remembers the live file for a rollback. $PRIV/prev.<name>.present marks it.
keep_previous() {
  if [ -f "$1" ]; then
    cat -- "$1" >"$PRIV/prev.$2"
    : >"$PRIV/prev.$2.present"
  fi
}

# restore_previous <live file> <name> <mode> <owner> <group>
restore_previous() {
  if [ -f "$PRIV/prev.$2.present" ]; then
    put_file "$PRIV/prev.$2" "$1" "$3" "$4" "$5" || printf 'apply: could not restore %s\n' "$1" >&2
  else
    rm -f -- "$1"
  fi
}

service_active() {
  systemctl is-active --quiet "$1"
}

# The OVH credential files: the staged ones when DNS mode is on, otherwise none (stale ones are removed).
ovh_names() {
  local pair
  for pair in $OVH_FILES; do
    printf '%s\n' "${pair#*:}"
  done
  for pair in $OVH_LEGACY_FILES; do
    printf '%s\n' "$pair"
  done
}

# install_ovh <staged dir>: creates /etc/caddy/ovh (root:caddy 0750) and installs the files in it, or removes them all
# when none are staged. Returns 1 on the first failure; the caller restores.
install_ovh() {
  local dir=$1 name
  if [ -z "$(ls -A -- "$dir")" ]; then
    for name in $(ovh_names); do
      rm -f -- "$CADDY_OVH_DIR/$name"
    done
    rmdir -- "$CADDY_OVH_DIR" 2>/dev/null || true
    return 0
  fi
  mkdir -p -- "$CADDY_OVH_DIR" && chmod 0750 "$CADDY_OVH_DIR" || return 1
  if [ "$AS_ROOT" -eq 1 ]; then
    chown root:caddy "$CADDY_OVH_DIR" || return 1
  fi
  local pair
  for pair in $OVH_FILES; do
    name=${pair#*:}
    put_file "$dir/$name" "$CADDY_OVH_DIR/$name" 0640 root caddy || return 1
    # An apply that reports success has written every credential file: check, never assume.
    [ -s "$CADDY_OVH_DIR/$name" ] || return 1
  done
  for name in $OVH_LEGACY_FILES; do
    rm -f -- "$CADDY_OVH_DIR/$name"
  done
}

restore_caddy() {
  local name
  restore_previous "$CADDYFILE" Caddyfile 0644 root root
  restore_previous "$CADDY_ENV" env 0640 root caddy
  for name in $(ovh_names); do
    restore_previous "$CADDY_OVH_DIR/$name" "ovh.$name" 0640 root caddy
  done
  rmdir -- "$CADDY_OVH_DIR" 2>/dev/null || true
}

# write_stored_certs <list file>: the names that hold a certificate in Caddy's storage with more than 30 days left (Caddy
# renews from 30 days), one per line, for the app, which cannot read Caddy's storage. The app keeps such a name as its own
# exact-name site (ovh_dns wildcard layout) so it keeps serving that certificate; the wildcard certificate itself is
# skipped. Best effort: a failure leaves the previous list and never fails the caller.
write_stored_certs() {
  local list=$1 base="$ROOT/var/lib/caddy/.local/share/caddy/certificates" crt name tmp
  [ -d "$(dirname -- "$list")" ] || return 0
  tmp=$(mktemp) || return 0
  for crt in "$base"/*/*/*.crt; do
    [ -f "$crt" ] || continue
    name=$(basename -- "$crt" .crt)
    case $name in wildcard_* | *[!a-zA-Z0-9.-]*) continue ;; esac
    openssl x509 -checkend 2592000 -noout -in "$crt" >/dev/null 2>&1 && printf '%s\n' "$name"
  done | sort -u >"$tmp" || true
  install -m 0644 -o root -g root -- "$tmp" "$list" 2>/dev/null || true
  rm -f -- "$tmp"
}

apply_caddy() {
  local changed_env=0 name
  stage_in Caddyfile "$PRIV/Caddyfile" || fail 'nothing staged: Caddyfile is missing' 66
  stage_in env "$PRIV/env" || fail 'nothing staged: env is missing' 66
  parse_caddy_env "$PRIV/env"

  # The validator's own copies: the config, the environment as a file only the caddy user can read, and the OVH files.
  # The Caddyfile names the live OVH directory; the copy names the validator's own, so the staged credentials are
  # what gets resolved ({file.*} is read when Caddy provisions the DNS module, which `caddy validate` does too).
  local live_ovh="${CADDY_OVH_DIR#"$ROOT"}/" text
  text=$(cat -- "$PRIV/Caddyfile"; printf x)
  text=${text%x}
  printf '%s' "${text//"$live_ovh"/$PUB/ovh/}" >"$PUB/Caddyfile"
  chmod 0644 "$PUB/Caddyfile"
  cat -- "$PRIV/env.canon" >"$PUB/env"
  chmod 0640 "$PUB/env"
  mkdir -p "$PUB/ovh"
  chmod 0750 "$PUB/ovh"
  cp -- "$PRIV/env.ovh/"* "$PUB/ovh/" 2>/dev/null || true
  chmod 0640 "$PUB/ovh/"* 2>/dev/null || true
  if [ "$AS_ROOT" -eq 1 ]; then
    chown root:caddy "$PUB/env" "$PUB/ovh"
    chown root:caddy "$PUB/ovh/"* 2>/dev/null || true
  fi

  if ! validator_run caddy "$T_VALIDATE" "$PUB/env" -- caddy validate --config "$PUB/Caddyfile" --adapter caddyfile >"$PRIV/validate.out" 2>&1; then
    tail -n 5 "$PRIV/validate.out" >&2 || true
    fail 'caddy validate rejected the staged Caddyfile; nothing was installed'
  fi

  # Only the proxy secret needs a restart (Caddy reads its environment at start). The OVH files are read on every
  # (re)load, and dropping the OVH_* lines an older apply left in the file changes nothing Caddy still uses.
  if [ "$(grep -s '^FLEET_PROXY_SECRET=' "$CADDY_ENV" || true)" != "$(cat -- "$PRIV/env.canon")" ]; then
    changed_env=1
  fi

  keep_previous "$CADDYFILE" Caddyfile
  keep_previous "$CADDY_ENV" env
  for name in $(ovh_names); do
    keep_previous "$CADDY_OVH_DIR/$name" "ovh.$name"
  done
  if ! install_ovh "$PRIV/env.ovh" || ! put_file "$PRIV/Caddyfile" "$CADDYFILE" 0644 root root || ! put_file "$PRIV/env.canon" "$CADDY_ENV" 0640 root caddy; then
    restore_caddy
    fail 'could not install the files; the previous Caddyfile, environment and OVH credentials were restored'
  fi

  if [ "$AS_ROOT" -eq 1 ]; then
    write_stored_certs "$ROOT/etc/caddy/fleet/stored-certs.list"
  fi

  if service_active caddy; then
    if [ "$changed_env" -eq 1 ]; then
      # Caddy reads its environment only when it starts, and the proxy secret is still an {env.X} placeholder. A reload
      # would hand the new Caddyfile to a process that still has the old secret. A restart loads Caddyfile and environment
      # together; the validation above already ran with the new environment. It is deferred because the reply to the
      # caller must not be cut by it (the caller is usually a request that Caddy proxies).
      systemd-run --on-active=3 --quiet systemctl restart caddy ||
        fail 'the new files are installed, but the restart of caddy could not be scheduled; run: systemctl restart caddy'
      printf 'apply: caddy restarts in 3 s to load its new environment\n'
    elif ! timeout "$T_RELOAD" systemctl reload caddy; then
      restore_caddy
      timeout "$T_RELOAD" systemctl reload caddy || printf 'apply: the reload after the rollback failed as well\n' >&2
      fail 'caddy rejected the reload; the previous Caddyfile, environment and OVH credentials were restored'
    fi
  else
    printf 'apply: caddy is not running; the files are installed and the next start uses them\n'
  fi
  printf 'apply: caddy installed\n'
}

# The Authelia account, from the installed unit. Fails closed: never root, and the account must exist.
authelia_account() {
  AUTH_USER=authelia
  AUTH_GROUP=authelia
  if [ "$AS_ROOT" -eq 1 ]; then
    AUTH_USER=$(systemctl show -p User --value authelia.service 2>/dev/null || true)
    AUTH_GROUP=$(systemctl show -p Group --value authelia.service 2>/dev/null || true)
    AUTH_USER=${AUTH_USER:-authelia}
    AUTH_GROUP=${AUTH_GROUP:-authelia}
    if [ "$AUTH_USER" = root ] || [ "$AUTH_GROUP" = root ]; then
      fail 'authelia.service runs as root; refusing to validate or install its configuration as root' 
    fi
    getent passwd "$AUTH_USER" >/dev/null || fail "the authelia account $AUTH_USER does not exist"
    getent group "$AUTH_GROUP" >/dev/null || fail "the authelia group $AUTH_GROUP does not exist"
  fi
}

apply_authelia() {
  local staged=0 pair
  local assignments=()
  authelia_account
  if stage_in configuration.yml "$PRIV/configuration.yml"; then
    staged=1
  fi

  if [ "$staged" -eq 1 ]; then
    cat -- "$PRIV/configuration.yml" >"$PUB/configuration.yml"
    chmod 0644 "$PUB/configuration.yml"
    for pair in $AUTHELIA_SECRET_FILES; do
      assignments+=("${pair%%=*}=$ROOT${pair#*=}")
    done
    if ! validator_run "$AUTH_USER" "$T_VALIDATE" - "${assignments[@]}" -- authelia config validate --config "$PUB/configuration.yml" >"$PRIV/validate.out" 2>&1; then
      tail -n 5 "$PRIV/validate.out" >&2 || true
      fail 'authelia config validate rejected the staged configuration; nothing was installed'
    fi
    keep_previous "$AUTHELIA_CONFIG" configuration.yml
    if ! put_file "$PRIV/configuration.yml" "$AUTHELIA_CONFIG" 0640 "$AUTH_USER" "$AUTH_GROUP"; then
      restore_previous "$AUTHELIA_CONFIG" configuration.yml 0640 "$AUTH_USER" "$AUTH_GROUP"
      fail 'could not install the configuration; the previous one was restored'
    fi
  fi

  if ! timeout "$T_RESTART" systemctl restart authelia; then
    if [ "$staged" -eq 1 ]; then
      restore_previous "$AUTHELIA_CONFIG" configuration.yml 0640 "$AUTH_USER" "$AUTH_GROUP"
      timeout "$T_RESTART" systemctl restart authelia || printf 'apply: the restart after the rollback failed as well\n' >&2
      fail 'authelia did not restart; the previous configuration was restored'
    fi
    fail 'authelia did not restart'
  fi
  if [ "$staged" -eq 1 ]; then
    printf 'apply: authelia configuration installed, authelia restarted\n'
  else
    printf 'apply: nothing staged, authelia restarted\n'
  fi
}

# --- 6. slices -------------------------------------------------------------------------------------------------

# slice_depth <unit>: 0 for fleet.slice, 1 for fleet-<p>.slice, 2 for fleet-<p>-<t>.slice.
slice_depth() {
  local name=${1%.slice} dashes=${1//[^-]/}
  if [ "$name" = fleet ]; then
    printf '0\n'
    return 0
  fi
  printf '%s\n' "${#dashes}"
}

slice_parent() {
  local name=${1%.slice}
  [ "$name" != fleet ] || return 1
  printf '%s.slice\n' "${name%-*}"
}

# systemctl_slice <args>...: one systemctl call with a timeout (the helper must stay inside the app's 60 s).
systemctl_slice() {
  timeout "$T_SLICE" systemctl "$@" </dev/null
}

# set_quota <unit> <percent|->: applies the quota to the RUNNING slice. `--runtime`: the persistent value is the drop-in
# this helper wrote, a second persistent copy (/etc/systemd/system.control) would only shadow it.
set_quota() {
  if [ "$2" = - ]; then
    systemctl_slice set-property --runtime "$1" 'CPUQuota='
  else
    systemctl_slice set-property --runtime "$1" "CPUQuota=$2%"
  fi
}

# drop_unit_dir <unit>: removes the unit's drop-in directory when it is empty (the unit name is validated by then).
drop_unit_dir() {
  rmdir -- "${SYSTEMD_UNIT_DIR:?}/${1:?}.d" 2>/dev/null || true
}

# slices_restore: puts every touched unit file and drop-in back (or removes the new ones), reloads and re-applies the
# previous quotas. Best effort, reports what it could not do.
slices_restore() {
  local unit prev q
  for unit in "${TOUCHED[@]}"; do
    restore_previous "$SYSTEMD_UNIT_DIR/$unit" "unit.$unit" 0644 root root
    restore_previous "$SYSTEMD_UNIT_DIR/$unit.d/$SLICE_DROPIN" "quota.$unit" 0644 root root
    drop_unit_dir "$unit"
  done
  timeout "$T_RELOAD" systemctl daemon-reload </dev/null || printf 'apply: daemon-reload after the rollback failed\n' >&2
  for unit in "${TOUCHED[@]}"; do
    # Only slices that existed before have a previous state worth re-applying.
    [ -f "$PRIV/prev.unit.$unit.present" ] || continue
    q=-
    if [ -f "$PRIV/prev.quota.$unit.present" ]; then
      prev=$(sed -n 's/^CPUQuota=\([0-9]\{1,6\}\)%$/\1/p' "$PRIV/prev.quota.$unit" | head -n 1)
      [ -z "$prev" ] || q=$prev
    fi
    set_quota "$unit" "$q" || printf 'apply: could not re-apply the previous quota of %s\n' "$unit" >&2
  done
}

apply_slices() {
  local threads max unit quota count=0 parent name u
  local -A want=()
  local -a order=() TOUCHED=() stale=()

  stage_in slices.json "$PRIV/slices.json" || fail 'nothing staged: slices.json is missing' 66

  threads=$(nproc --all 2>/dev/null || true)
  if ! [[ $threads =~ ^[0-9]{1,5}$ ]] || [ "$threads" -lt 1 ]; then
    fail 'cannot determine the number of CPU threads'
  fi
  max=$((threads * 100))

  # Shape first (jq, on the root-owned copy, with a timeout), then every value again in bash: the bash checks are
  # authoritative, jq only makes the line format below safe to read.
  if ! timeout "$T_VALIDATE" jq -e '
      type == "array" and length > 0 and length <= 500 and
      all(.[]; type == "object" and (keys | sort) == ["quota_percent", "unit"]
        and (.unit | type == "string" and length <= 200 and test("^[a-z0-9_.-]+$"))
        and (.quota_percent == null or (.quota_percent | type == "number" and . == floor and . >= 100 and . <= 100000)))' \
    "$PRIV/slices.json" >/dev/null 2>&1 </dev/null; then
    fail 'slices.json is not a list of {"unit": ..., "quota_percent": integer|null} objects' 65
  fi
  timeout "$T_VALIDATE" jq -r '.[] | "\(.unit)\t\(.quota_percent // "-")"' "$PRIV/slices.json" >"$PRIV/slices.tsv" 2>/dev/null </dev/null ||
    fail 'cannot read slices.json' 65

  while IFS=$'\t' read -r unit quota; do
    count=$((count + 1))
    [ "$count" -le "$MAX_SLICES" ] || fail "more than $MAX_SLICES slices" 65
    if ! [[ $unit =~ $SLICE_UNIT_RE ]] || [ "${#unit}" -gt "$SLICE_MAX_NAME" ]; then
      fail "refused slice unit name (entry $count)" 65
    fi
    [ -z "${want[$unit]:-}" ] || fail "slice listed twice (entry $count)" 65
    if [ "$quota" != - ]; then
      [[ $quota =~ ^[1-9][0-9]{2,5}$ ]] || fail "refused quota for entry $count" 65
      if [ "$quota" -gt "$max" ]; then
        fail "quota of entry $count is above the host's $max% ($threads threads)" 65
      fi
    fi
    want[$unit]=$quota
    order+=("$unit")
  done <"$PRIV/slices.tsv"
  [ -n "${want[fleet.slice]:-}" ] || fail 'fleet.slice is missing from the list' 65
  for unit in "${order[@]}"; do
    if parent=$(slice_parent "$unit"); then
      [ -n "${want[$parent]:-}" ] || fail "the parent of entry $unit is not listed" 65
    fi
  done
  # Parents first: shallowest units first (stable by name).
  mapfile -t order < <(for unit in "${order[@]}"; do printf '%s %s\n' "$(slice_depth "$unit")" "$unit"; done | sort -k1,1n -k2,2 | cut -d' ' -f2)

  # Every existing file under a wanted name must be one this helper wrote.
  for unit in "${order[@]}"; do
    if [ -e "$SYSTEMD_UNIT_DIR/$unit" ] || [ -L "$SYSTEMD_UNIT_DIR/$unit" ]; then
      if [ -L "$SYSTEMD_UNIT_DIR/$unit" ] || [ ! -f "$SYSTEMD_UNIT_DIR/$unit" ] || ! grep -qxF -- "$SLICE_MARK" "$SYSTEMD_UNIT_DIR/$unit"; then
        fail "$unit exists and is not managed by ddev-fleet; refusing to replace it" 65
      fi
    fi
    if [ -L "$SYSTEMD_UNIT_DIR/$unit.d" ] || { [ -e "$SYSTEMD_UNIT_DIR/$unit.d" ] && [ ! -d "$SYSTEMD_UNIT_DIR/$unit.d" ]; }; then
      fail "$unit.d is not a directory; refusing to use it" 65
    fi
    if [ -L "$SYSTEMD_UNIT_DIR/$unit.d/$SLICE_DROPIN" ]; then
      fail "the drop-in of $unit is a symlink; refusing to use it" 65
    fi
  done
  # Stale: managed fleet*.slice files that are no longer listed. A glob over the one directory, no find, no recursion.
  for u in "$SYSTEMD_UNIT_DIR"/fleet*.slice; do
    if [ ! -f "$u" ] || [ -L "$u" ]; then
      continue
    fi
    name=$(basename -- "$u")
    [[ $name =~ $SLICE_UNIT_RE ]] || continue
    [ -z "${want[$name]:-}" ] || continue
    grep -qxF -- "$SLICE_MARK" "$u" || continue
    stale+=("$name")
  done

  # --- install (atomic per file), remembering every previous state
  for unit in "${order[@]}" "${stale[@]}"; do
    TOUCHED+=("$unit")
    keep_previous "$SYSTEMD_UNIT_DIR/$unit" "unit.$unit"
    keep_previous "$SYSTEMD_UNIT_DIR/$unit.d/$SLICE_DROPIN" "quota.$unit"
  done
  for unit in "${order[@]}"; do
    printf '%s\n[Unit]\nDescription=ddev-fleet CPU allotment (%s)\n\n[Slice]\nCPUAccounting=yes\n' "$SLICE_MARK" "$unit" >"$PRIV/new.unit"
    quota=${want[$unit]}
    if ! put_file "$PRIV/new.unit" "$SYSTEMD_UNIT_DIR/$unit" 0644 root root; then
      slices_restore
      fail 'could not install the slice units; the previous ones were restored'
    fi
    if [ "$quota" = - ]; then
      rm -f -- "${SYSTEMD_UNIT_DIR:?}/${unit:?}.d/$SLICE_DROPIN"
      drop_unit_dir "$unit"
    else
      printf '%s\n[Slice]\nCPUQuota=%s%%\n' "$SLICE_MARK" "$quota" >"$PRIV/new.drop"
      if ! install -d -m 0755 -- "$SYSTEMD_UNIT_DIR/$unit.d" || ! put_file "$PRIV/new.drop" "$SYSTEMD_UNIT_DIR/$unit.d/$SLICE_DROPIN" 0644 root root; then
        slices_restore
        fail 'could not install the slice drop-ins; the previous ones were restored'
      fi
    fi
  done
  for unit in "${stale[@]}"; do
    rm -f -- "${SYSTEMD_UNIT_DIR:?}/${unit:?}" "${SYSTEMD_UNIT_DIR:?}/${unit:?}.d/$SLICE_DROPIN"
    drop_unit_dir "$unit"
  done

  # --- make it live: reload, start every slice before anything uses it, then the quotas on the running slices
  if ! timeout "$T_RELOAD" systemctl daemon-reload </dev/null; then
    slices_restore
    fail 'systemd did not reload; the previous slice units were restored'
  fi
  for unit in "${order[@]}"; do
    if ! systemctl_slice start "$unit"; then
      slices_restore
      fail "could not start $unit; the previous slice units were restored"
    fi
  done
  for unit in "${order[@]}"; do
    if ! set_quota "$unit" "${want[$unit]}"; then
      slices_restore
      fail "could not set the quota of $unit; the previous slice units and quotas were restored"
    fi
  done
  # A removed slice stops limiting new containers; containers still inside it keep running (unlimited) rather than being killed.
  for unit in "${stale[@]}"; do
    set_quota "$unit" - || printf 'apply: could not lift the quota of the removed slice %s\n' "$unit" >&2
  done
  printf 'apply: slices installed (%d, %d removed)\n' "${#order[@]}" "${#stale[@]}"
}

pin_staging || true
case $TARGET in
  caddy) apply_caddy ;;
  authelia) apply_authelia ;;
  slices) apply_slices ;;
esac
