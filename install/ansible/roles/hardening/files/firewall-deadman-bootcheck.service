# Installed by ddev-fleet host hardening (install --harden). Enabled only while the switch is armed or confirmed:
# the fire script turns the firewall OFF whenever the confirmation marker is missing, and this runs on every boot.
[Unit]
Description=ddev-fleet firewall dead-man's switch: boot-time reconfirmation check
After=network.target ufw.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fleet-firewall-deadman-fire

[Install]
WantedBy=multi-user.target
