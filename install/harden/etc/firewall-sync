#!/usr/bin/env bash
# Installed by ddev-fleet host hardening (install --harden) as /usr/local/sbin/fleet-firewall-sync, run as root by
# fleet-firewall-sync.service every minute and once by the installer. Takes no arguments and no input from the fleet
# user other than Fleet's own answer to "which public ports do the projects use" (`fleet:port:firewall --json`, read
# from the Fleet database, never from a file).
#
# It opens each such port and closes the ports it opened earlier that no project uses any more. It owns ONLY the ports
# listed in its state file: SSH, 80, 443 and any rule the operator added by hand are never touched. When Fleet cannot be
# asked (the console fails, the answer is not the expected JSON) it changes nothing and exits 1.
set -euo pipefail
export LC_ALL=C
# FLEET_FIREWALL_TEST_PATH lets the unit tests put stubs first; systemd runs this with a clean environment.
PATH=${FLEET_FIREWALL_TEST_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}

# FLEET_FIREWALL_* exist for the unit tests; the installed copy runs as root from a fixed place.
STATE=${FLEET_FIREWALL_STATE:-/var/lib/ddev-fleet/firewall-ports}
CONF=${FLEET_FIREWALL_CONF:-/etc/ddev-fleet/hardening.conf}
ENV_FILE=${FLEET_FIREWALL_ENV_FILE:-/etc/ddev-fleet/fleet.env}
APP_DIR=${FLEET_FIREWALL_APP_DIR:-/opt/ddev-fleet/app}
LOCK=${FLEET_FIREWALL_LOCK:-/run/lock/fleet-firewall-sync.lock}

# Ports that are never ours to open or close.
keep='^(80|443)$'
# The settings file is written after the installer's first sync: a missing file means no SSH ports to skip, not a failure.
ssh_ports=$( { sed -n 's/^SSH_PORTS=//p' "$CONF" 2>/dev/null || true; } | head -n 1 | tr -cd '0-9 ')

exec 9>"$LOCK"
flock -n 9 || { echo "fleet-firewall-sync: another run is in progress"; exit 0; }

# shellcheck disable=SC2016  # the inner script is single-quoted on purpose
json=$(runuser -u fleet -- env HOME=/home/fleet bash -c 'set -a; . "$1"; set +a; cd "$2" && exec php8.4 bin/console fleet:port:firewall --json' fleet-fw "$ENV_FILE" "$APP_DIR" </dev/null) ||
  { echo "fleet-firewall-sync: Fleet did not answer; nothing changed" >&2; exit 1; }
want=$(printf '%s' "$json" | jq -er '.ports | map(.port | tostring) | .[]') ||
  { echo "fleet-firewall-sync: unexpected answer from Fleet; nothing changed" >&2; exit 1; }

desired=()
for p in $want; do
  [[ $p =~ ^[0-9]{1,5}$ ]] && [ "$p" -ge 1 ] && [ "$p" -le 65535 ] || { echo "fleet-firewall-sync: bad port '$p'; nothing changed" >&2; exit 1; }
  [[ $p =~ $keep ]] && continue
  skip=0
  for s in $ssh_ports; do [ "$s" = "$p" ] && skip=1; done
  [ "$skip" = 0 ] || continue
  desired+=("$p")
done

managed=()
if [ -f "$STATE" ]; then
  while read -r p; do
    [[ $p =~ ^[0-9]{1,5}$ ]] && managed+=("$p")
  done <"$STATE"
fi

in_list() {
  local needle=$1 x
  shift
  for x in "$@"; do [ "$x" = "$needle" ] && return 0; done
  return 1
}

changed=0
new_state=()
for p in "${desired[@]}"; do
  if ! in_list "$p" "${managed[@]}"; then
    if ufw show added 2>/dev/null | grep -Eq "^ufw allow $p/tcp( |$)"; then
      # Opened by hand: leave it alone, and never close it later.
      continue
    fi
    ufw allow "$p/tcp" comment 'fleet named port' >/dev/null
    echo "fleet-firewall-sync: opened $p/tcp"
    changed=1
  fi
  new_state+=("$p")
done
for p in "${managed[@]}"; do
  if ! in_list "$p" "${desired[@]}"; then
    ufw delete allow "$p/tcp" >/dev/null || true
    echo "fleet-firewall-sync: closed $p/tcp"
    changed=1
  fi
done

mkdir -p "$(dirname "$STATE")"
tmp=$(mktemp "$STATE.XXXXXX")
printf '%s\n' "${new_state[@]}" | grep . >"$tmp" || : >"$tmp"
chmod 0644 "$tmp"
mv -f "$tmp" "$STATE"
[ "$changed" = 1 ] || echo "fleet-firewall-sync: ${#desired[@]} named port(s), nothing to change"
