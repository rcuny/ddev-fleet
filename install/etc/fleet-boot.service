# Installed by ddev-fleet (the Ansible role units) as /etc/systemd/system/fleet-boot.service.
# After a reboot, starts every instance (stopped ones too, as v0 did), one at a time. Enabled by the installer, never
# started by it.
[Unit]
Description=ddev-fleet start the instances at boot
After=docker.service network-online.target fleet-worker@1.service
Wants=network-online.target

[Service]
# Type=exec (NOT oneshot) is deliberate (FLE-4, regression FLE-196). A Type=exec unit counts as started once
# ExecStart is exec'd, so multi-user.target completes at once and the sequential batch keeps running. With
# Type=oneshot, multi-user.target (this unit is WantedBy it) waited for the whole batch, and the Authelia .deb unit
# has After=multi-user.target, so Authelia (and with it every forward_auth URL) answered 502 until the last instance
# was up. Do NOT add Before=/After= against multi-user.target or authelia.service: it would block again.
# The unit goes inactive when the batch ends; a non-zero exit (an instance failed) marks it failed, visible in
# `systemctl --failed`. Result log: `journalctl -u fleet-boot -b`.
Type=exec
User=fleet
Group=fleet
EnvironmentFile=/etc/ddev-fleet/fleet.env
Environment=HOME=/home/fleet
WorkingDirectory=/opt/ddev-fleet/app
TimeoutStartSec=0
ExecStart=/usr/bin/php8.4 /opt/ddev-fleet/app/bin/console fleet:instance:start --all --sequential --timeout=1800 --retry-port-conflict

[Install]
WantedBy=multi-user.target
