# Installed by ddev-fleet (the Ansible role units) as /etc/systemd/system/fleet-backup.timer and enabled by the same role.
# Daily database backup; Persistent runs a missed one at the next boot.
[Unit]
Description=Daily ddev-fleet database backup

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
