# Installed by ddev-fleet (the Ansible role units) as /etc/systemd/system/fleet-tls-check.timer and enabled by the same role.
# Every 10 minutes, starting a few minutes after boot.
[Unit]
Description=ddev-fleet certificate health check every 10 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min
AccuracySec=30s

[Install]
WantedBy=timers.target
