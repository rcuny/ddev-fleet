# Installed by ddev-fleet (the Ansible role units) as /etc/systemd/system/fleet-upgrade-check.timer and enabled by the same role.
# Daily look at the published releases; the delay spreads the hosts over the day, and Persistent runs a missed check at
# the next boot.
[Unit]
Description=Daily ddev-fleet release check

[Timer]
OnCalendar=daily
RandomizedDelaySec=6h
Persistent=true

[Install]
WantedBy=timers.target
