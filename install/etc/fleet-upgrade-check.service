# Installed by ddev-fleet (the Ansible role units) as /etc/systemd/system/fleet-upgrade-check.service.
# One look at the published releases (fleet:upgrade:refresh: `git ls-remote` of the release tags into the cached
# catalog the Upgrade page and the version notice read). Started by fleet-upgrade-check.timer; `systemctl start
# fleet-upgrade-check` runs it by hand. It only checks: nothing here installs or changes the host.
[Unit]
Description=ddev-fleet release check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=fleet
Group=fleet
EnvironmentFile=/etc/ddev-fleet/fleet.env
# git wants a home it can read; the real one is hidden by ProtectHome, and PrivateTmp makes this one private.
Environment=HOME=/tmp
WorkingDirectory=/opt/ddev-fleet/app
ExecStart=/usr/bin/php8.4 /opt/ddev-fleet/app/bin/console fleet:upgrade:refresh
TimeoutStartSec=2min
Nice=10
IOSchedulingClass=idle
# Reads the public release list over HTTPS and writes the app's cache. No sudo, no Docker, no home directory.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
# The cache lives in the app's var directory; FLEET_HOME is listed like the backup unit does (UnitsTest keeps them in step).
ReadWritePaths=/srv/fleet /opt/ddev-fleet/app/var
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# git and the resolver: sockets to the network and to local resolvers.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
