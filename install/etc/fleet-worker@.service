# Installed by ddev-fleet (the Ansible role units) as /etc/systemd/system/fleet-worker@.service.
# ONE Messenger worker (fleet-worker@1 is the only one the installer enables): the SQLite messenger queue cannot be
# consumed by more than one worker without "database is locked" failures, so do not enable fleet-worker@2.
[Unit]
Description=ddev-fleet job worker %i
After=network.target docker.service
Wants=docker.service

[Service]
User=fleet
Group=fleet
EnvironmentFile=/etc/ddev-fleet/fleet.env
Environment=HOME=/home/fleet
WorkingDirectory=/opt/ddev-fleet/app
ExecStart=/usr/bin/php8.4 /opt/ddev-fleet/app/bin/console messenger:consume jobs --time-limit=3600 --memory-limit=256M -vv
Restart=always
RestartSec=5
# FLE-167: per-instance ssh-agents (container_ssh) are started by this worker. KillMode=process makes a restart of the unit
# (the hourly --time-limit, deploys, upgrades) stop only the worker, not the agents it spawned or the ddev they ran; the
# status watcher revives an agent that died anyway. A `systemctl stop` therefore leaves them running, by design.
KillMode=process
# A restart on upgrade lets the running message finish (a `ddev start` can take minutes) before systemd kills it.
TimeoutStopSec=600
# /etc, /usr and /boot read-only except what the worker writes. Deliberately NOT set: NoNewPrivileges (sudo),
# PrivateTmp (the sockets under /tmp are shared), ProtectHome (DDEV lives in /home/fleet), ProcSubset=pid, PrivateUsers
# (unmaps the docker group), UMask=0027 (Caddy must read what the worker writes). A path outside this list fails with
# EROFS, not EACCES.
# M0.04 jobs do not call the sudo apply helper; the first job that does (M0.10 per-instance Authelia rules) must add
# `-/etc/caddy -/etc/authelia` to ReadWritePaths (php-fpm's drop-in already lists them): the helper inherits this unit's
# mount namespace, so those paths are read-only to it and the install would fail with EROFS.
ProtectSystem=full
ReadWritePaths=/srv/fleet /etc/caddy/fleet /home/fleet /opt/ddev-fleet/app/var

[Install]
WantedBy=multi-user.target
