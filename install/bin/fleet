#!/usr/bin/env bash
# The `fleet` command: runs the app's console commands on this host.
#
#   fleet setup:token              ->  php8.4 /opt/ddev-fleet/app/bin/console fleet:setup:token
#   fleet user:reset-password bob  ->  ... fleet:user:reset-password bob
#   fleet project list --json      ->  ... fleet:project:list --json   (a "<group> <verb>" pair works as "<group>:<verb>")
#   fleet fleet:host:render        ->  an already prefixed name is accepted as it is
#   fleet doctrine:migrations:status -> ... doctrine:migrations:status, with the application environment loaded
#   fleet                          ->  lists the fleet:* commands
#   fleet list | help <cmd> | ...  ->  anything that does not start with one of our groups goes to the console unchanged
#
# Installed by install/steps/90-privileged.sh as /usr/local/bin/fleet (root:root 0755). Everyone but the `fleet` user
# is re-executed as `fleet` through sudo (root and sudoers members); `fleet` itself loads /etc/ddev-fleet/fleet.env,
# the same configuration the web app and the workers run with, and starts the console.
set -euo pipefail

FLEET_USER=fleet
# FLEET_WRAPPER_* exist for the unit tests only. They are read after the switch to `fleet` (sudo resets the
# environment on the way), so they can never redirect a privileged run: this script has no privileges of its own.
ENV_FILE=${FLEET_WRAPPER_ENV_FILE:-/etc/ddev-fleet/fleet.env}
CONSOLE=${FLEET_WRAPPER_CONSOLE:-/opt/ddev-fleet/app/bin/console}
PHP=${FLEET_WRAPPER_PHP:-php8.4}

if [ "$(id -un)" != "$FLEET_USER" ]; then
  exec sudo -u "$FLEET_USER" -- /usr/local/bin/fleet "$@"
fi

if [ ! -r "$ENV_FILE" ]; then
  printf 'fleet: cannot read %s (is ddev-fleet installed on this host?)\n' "$ENV_FILE" >&2
  exit 1
fi
export HOME=/home/fleet
# Start from a directory the `fleet` user can always enter: the caller's (an administrator's home, say) is often closed
# to it, and then every process the console starts fails ("posix_spawn() failed: Permission denied").
cd "$HOME" 2>/dev/null || cd /
set -a
# shellcheck source=/dev/null
. "$ENV_FILE"
set +a

if [ "$#" -eq 0 ]; then
  exec "$PHP" "$CONSOLE" list fleet
fi

command=$1
shift
# Only these groups get the `fleet:` prefix (every other console command, doctrine:* for one, keeps its own name).
# One group per line, sorted, so two branches adding a group rarely touch the same line.
# tests/Repo/CliGroupsTest.php keeps the list in step with the commands.
FLEET_GROUPS=(
  asset
  backup
  claude
  host
  instance
  job
  port
  project
  secret
  setup
  template
  tmux
  user
  webhook
  workspace
)
groups=$(IFS='|'; printf '%s' "${FLEET_GROUPS[*]}")
if [[ $command =~ ^fleet:[a-z][a-z0-9:-]*$ ]]; then
  :
elif [[ $command =~ ^($groups):[a-z][a-z0-9:-]*$ ]]; then
  command="fleet:$command"
elif [[ $command =~ ^($groups)$ && ${1:-} =~ ^[a-z][a-z0-9-]*$ ]]; then
  command="fleet:$command:$1"
  shift
fi
exec "$PHP" "$CONSOLE" "$command" "$@"
