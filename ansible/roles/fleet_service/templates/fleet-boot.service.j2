[Unit]
Description=ddev-fleet: start all instances sequentially after a reboot
# docker.service must be up before `fleet start` can talk to the Docker
# socket; fleet.service (the daemon) doesn't strictly have to be running
# first, but ordering after it avoids racing daemon startup against a long
# batch of `ddev start` calls on the same host. network-online.target covers
# instances whose containers need to resolve/reach anything on first boot.
After=docker.service network-online.target fleet.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=no
# Starting every instance sequentially can take many minutes on a fleet with
# a large instance count (one `ddev start` at a time, deliberately — see
# ExecStart comment below). Do NOT let systemd's default 90s start timeout
# kill this mid-batch.
TimeoutStartSec=0
# Same identity/venv/env pattern as fleet.service.j2 (User={{ fleet_user }},
# WorkingDirectory={{ fleet_opt_dir }}, EnvironmentFile from .secrets) —
# invoking the venv's `fleet` entrypoint directly, NOT the /usr/local/bin/fleet
# wrapper (fleet.j2), because that wrapper re-execs itself via
# `sudo -u {{ fleet_user }}` when the caller isn't already {{ fleet_user }};
# since this unit already runs as User={{ fleet_user }}, going through the
# wrapper would be a pointless double-sudo. --sequential (not the default
# 2-at-a-time run_concurrent) is required here: many `ddev start`s at once
# on a freshly-rebooted host causes CPU spikes and ddev-ssh-agent
# registration races. --timeout 1800 is a per-instance HANG guard, not a
# slowness limit: if a single `ddev start` doesn't finish within 30 minutes
# (e.g. an ssh-agent passphrase prompt blocking forever in this
# non-interactive boot context) it is killed and recorded as a failed
# instance, and the batch moves on to the next one instead of stalling
# forever — TimeoutStartSec=0 above still lets the whole batch legitimately
# run long across many instances. --retry-port-conflict is a SEPARATE
# self-heal for a different failure mode: even run one-at-a-time, some
# instances' `ddev start` FAST-FAILs on a Docker port-allocation race (the
# db container's host port hasn't been released by the kernel yet — error
# text mentions "port is already allocated" / "failed to set up container
# networking"), leaving the web container Up-but-unhealthy. Unlike the hang
# above, this fails almost instantly, so the --timeout guard never sees it.
# The flag makes `fleet start` do exactly the proven manual fix — one clean
# `ddev stop` + `ddev start` — automatically before giving up on that
# instance; a still-failing retry (or any non-port-conflict error) still
# just fails that instance and the batch continues, as before.
User={{ fleet_user }}
WorkingDirectory={{ fleet_opt_dir }}
EnvironmentFile={{ fleet_srv_dir }}/.secrets
ExecStart={{ fleet_opt_dir }}/venv/bin/fleet start --all --sequential --timeout 1800 --retry-port-conflict

[Install]
WantedBy=multi-user.target
