{# Shared [Service] sandbox for fleet.service and fleet-boot.service (FLE-1).
   Included by both so the two units cannot drift. Needs fleet_srv_dir,
   fleet_caddy_snippet_dir and fleet_home_dir. fleet-reboot-notify.service
   (security_hardening role) carries its own, smaller copy — a role cannot
   include another role's templates; tests/pytest/ansible/test_systemd_sandbox.py guards
   against drift between the two. #}
# systemd sandbox (FLE-1; score 8.7 -> 1.8 in `systemd-analyze security`).
# Validated on a live server under exactly this set, incl. a full
# `ddev config` + `ddev start`. The fleet user is in the docker group, which
# is root-equivalent, so this is defense in depth, not containment.
# The daemon can only WRITE to ReadWritePaths (anything else fails with
# EROFS, Errno 30) — widen ReadWritePaths for new paths, don't weaken this.
# Deliberately NOT set (each breaks something):
#   PrivateTmp=yes     the tmux socket /tmp/tmux-<uid> is shared with
#                      fleet-tmux and the operators
#   ProcSubset=pid     core/sysinfo.py reads /proc/meminfo
#   PrivateUsers=yes   unmaps the docker group -> no Docker socket
#   UMask=0027         Caddy must read the snippets the daemon writes into
#                      {{ fleet_caddy_snippet_dir }}
#   RemoveIPC=yes      the fleet uid is shared with fleet-tmux's operator panes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{ fleet_srv_dir }} {{ fleet_caddy_snippet_dir }} {{ fleet_home_dir }} /tmp /var/tmp
ProtectHome=read-only
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryDenyWriteExecute=yes
PrivateDevices=yes
ProtectProc=invisible
