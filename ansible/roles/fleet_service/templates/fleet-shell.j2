#!/usr/bin/env bash
# fleet-shell — drop into an interactive shell as the '{{ fleet_user }}' user (the
# identity that owns every DDEV instance), optionally straight inside an instance
# directory. Installed by the ddev-fleet Ansible provisioning (fleet_service role).
#
#   fleet-shell                              shell as {{ fleet_user }} in {{ fleet_srv_dir }}
#   fleet-shell <project>--<instance>        shell as {{ fleet_user }} in that instance
#   fleet-shell -l                           just list the instances
#
# Once inside, use ddev normally:
#   ddev describe | ddev ssh | ddev drush uli | ddev logs | ddev restart
set -euo pipefail

FLEET_USER={{ fleet_user }}
INSTANCES={{ fleet_srv_dir }}/instances

if [ "${1:-}" = "-l" ] || [ "${1:-}" = "--list" ]; then
  sudo -u "$FLEET_USER" ls -1 "$INSTANCES" 2>/dev/null || echo "(no instances yet)"
  exit 0
fi

target={{ fleet_srv_dir }}
if [ -n "${1:-}" ]; then
  target="$INSTANCES/$1"
  if ! sudo -u "$FLEET_USER" test -d "$target"; then
    echo "fleet-shell: no such instance '$1'" >&2
    echo "available instances:" >&2
    sudo -u "$FLEET_USER" ls -1 "$INSTANCES" 2>/dev/null | sed 's/^/  /' >&2
    exit 1
  fi
fi

echo "→ $FLEET_USER user @ ${target}   (ddev ready: ddev describe | ddev ssh | ddev drush uli)"
exec sudo -u "$FLEET_USER" -H bash -c "cd '${target}' && exec bash"
