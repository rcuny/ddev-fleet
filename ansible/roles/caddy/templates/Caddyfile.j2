# Global options block — MUST be first in the Caddyfile (spec §9.3).
{
    email {{ acme_email }}
    on_demand_tls {
        ask http://127.0.0.1:{{ fleet_daemon_port }}/api/tls-authorize
    }
}

{{ fleet_domain }} {
    # Everything except the deploy-log WebSocket sits behind basic-auth.
    # Browsers do not send basic-auth credentials on a WebSocket handshake,
    # so /ws/* is exempted here; the daemon authenticates it instead with a
    # short-lived, instance-scoped token in the query string.
    @protected not path /ws/*
    basic_auth @protected {
        # Fleet-owned and rotatable WITHOUT Ansible (fleet.core.caddyauth +
        # `fleet set-admin-password` / `fleet rotate-admin-password`) — this
        # imports a single LITERAL file, not a glob. Caddy treats a missing
        # literal import path as a hard error, but a glob matching zero
        # files as a silent no-op (verified against the Caddy docs); using a
        # literal path here means Ansible's one-time seed task
        # (roles/caddy/tasks/main.yml) is what guarantees the file always
        # exists, and rotation after that never needs a re-render of this
        # Caddyfile.
        import {{ fleet_caddy_snippet_dir }}/admin-auth.conf
    }
    reverse_proxy 127.0.0.1:{{ fleet_daemon_port }}
}

*.{{ fleet_domain }} {
    # Caddy terminates the client TLS (on-demand cert per instance) and proxies
    # to DDEV's Traefik HTTP entrypoint. Proxying to Traefik's HTTPS port
    # ({{ ddev_router_https_port }}) instead returns 404 — Traefik's HTTPS router
    # matching does not engage for Caddy's proxied request — whereas the HTTP
    # entrypoint routes correctly by Host header. Caddy sets
    # X-Forwarded-Proto=https so Drupal still sees the request as secure; the
    # 127.0.0.1 hop is plaintext-safe (never leaves the host).
    #
    # Per-instance basic auth: each instance opting in (default: on) gets its
    # own fleet-owned snippet at {{ fleet_caddy_snippet_dir }}/instances/<id>.conf
    # — written/rotated/removed at deploy/destroy time by fleet.core.caddyauth,
    # never by Ansible. This is a GLOB import, unlike the dashboard's literal
    # admin-auth import above: the instances/ directory legitimately can be
    # empty (no instances with auth yet), and a glob matching zero files is a
    # silent Caddy no-op, whereas a literal missing path is a hard
    # validate/reload error (verified against Caddy v2.8.4, 2026-07-16). Each
    # snippet defines its own `@auth-<id>` matcher scoped with `host` to that
    # instance's FQDN, so instances are never affected by each other's auth
    # state.
    import {{ fleet_caddy_snippet_dir }}/instances/*.conf
    reverse_proxy 127.0.0.1:{{ ddev_router_http_port }}
    tls {
        on_demand
    }
}

# Fleet-managed named-port exposure (e.g. Typesense, Playwright reports):
# one snippet per port NAME with >=1 subscribing project, generated by
# fleet.core.caddyports and reconciled by `fleet refresh-ports` / deploy() /
# destroy() / daemon startup — never rendered by Ansible past the initial
# empty-directory seed below. A glob matching zero files is a verified
# silent Caddy no-op (same reasoning as the instances/*.conf auth import
# above), so an empty ports/ dir (e.g. right after provisioning, before
# any project opts into a named port) is not an error.
import {{ fleet_caddy_snippet_dir }}/ports/*.conf
