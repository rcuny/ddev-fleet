{% set fleet_auth_mode = fleet_auth_mode | default('basic') %}
# Global options block — MUST be first in the Caddyfile (spec §9.3).
{
    email {{ acme_email }}
    on_demand_tls {
        ask http://127.0.0.1:{{ fleet_daemon_port }}/api/tls-authorize
    }
}

{{ fleet_domain }} {
    # Everything except the deploy-log WebSocket sits behind auth.
    # Browsers do not send basic-auth credentials on a WebSocket handshake,
    # so /ws/* is exempted here; the daemon authenticates it instead with a
    # short-lived, instance-scoped token in the query string.
{% if fleet_auth_mode == 'authelia' %}
    # Authelia mode: the dashboard requires the `admins` group only (spec
    # D3). Client-supplied Remote-* headers are stripped before
    # forward_auth, same anti-spoofing rule as every instance's snippet
    # (fleet.core.caddyauth.write_instance_authelia_snippet). The whole
    # sequence MUST be wrapped in a `route` block — Caddy reorders bare
    # top-level directives by a fixed precedence list (running
    # request_header AFTER forward_auth otherwise), which would silently
    # strip the very Remote-Groups header forward_auth's copy_headers just
    # set and deny every authenticated user, admins included — confirmed
    # against a real Caddy v2.11.4 + Authelia v4.39 instance (see
    # caddyauth.py's write_instance_authelia_snippet docstring). /ws/*
    # keeps its existing token-based exemption, unprotected here as before.
    @protected not path /ws/*
    route @protected {
        request_header -Remote-User
        request_header -Remote-Groups
        request_header -Remote-Name
        request_header -Remote-Email
        forward_auth 127.0.0.1:9091 {
            uri /api/authz/forward-auth
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        @denied not header_regexp Remote-Groups "(^|,)\s*admins\s*(,|$)"
        respond @denied 403
    }
{% else %}
    @protected not path /ws/*
    basic_auth @protected {
        # Fleet-owned and rotatable WITHOUT Ansible (fleet.core.caddyauth +
        # `fleet set-admin-password` / `fleet rotate-admin-password`) — this
        # imports a single LITERAL file, not a glob. Caddy treats a missing
        # literal import path as a hard error, but a glob matching zero
        # files as a silent no-op (verified against the Caddy docs); using a
        # literal path here means Ansible's one-time seed task
        # (roles/caddy/tasks/main.yml) is what guarantees the file always
        # exists, and rotation after that never needs a re-render of this
        # Caddyfile.
        import {{ fleet_caddy_snippet_dir }}/admin-auth.conf
    }
{% endif %}
    reverse_proxy 127.0.0.1:{{ fleet_daemon_port }}
}

{% if fleet_auth_mode == 'authelia' %}
auth.{{ fleet_domain }} {
    # Authelia's own login portal. Covered by the *.{{ fleet_domain }}
    # wildcard cert in ovh_dns mode (tls.conf); in on_demand mode,
    # /api/tls-authorize special-cases this exact hostname (daemon.py).
    reverse_proxy 127.0.0.1:9091
    import {{ fleet_caddy_snippet_dir }}/tls.conf
}

{% endif %}
*.{{ fleet_domain }} {
    # Caddy terminates the client TLS (per-hostname on-demand cert, or a
    # single shared *.{{ fleet_domain }} wildcard cert — see the tls.conf
    # import below) and proxies to DDEV's Traefik HTTP entrypoint. Proxying
    # to Traefik's HTTPS port ({{ ddev_router_https_port }}) instead returns
    # 404 — Traefik's HTTPS router matching does not engage for Caddy's
    # proxied request — whereas the HTTP entrypoint routes correctly by
    # Host header. Caddy sets X-Forwarded-Proto=https so Drupal still sees
    # the request as secure; the 127.0.0.1 hop is plaintext-safe (never
    # leaves the host).
    #
    # Per-instance basic auth: each instance opting in (default: on) gets its
    # own fleet-owned snippet at {{ fleet_caddy_snippet_dir }}/instances/<id>.conf
    # — written/rotated/removed at deploy/destroy time by fleet.core.caddyauth,
    # never by Ansible. This is a GLOB import, unlike the dashboard's literal
    # admin-auth import above: the instances/ directory legitimately can be
    # empty (no instances with auth yet), and a glob matching zero files is a
    # silent Caddy no-op, whereas a literal missing path is a hard
    # validate/reload error (verified against Caddy v2.8.4, 2026-07-16). Each
    # snippet defines its own `@auth-<id>` matcher scoped with `host` to that
    # instance's FQDN, so instances are never affected by each other's auth
    # state.
    import {{ fleet_caddy_snippet_dir }}/instances/*.conf
    reverse_proxy 127.0.0.1:{{ ddev_router_http_port }}
    # Instances are ephemeral, often unfinished work — keep them out of
    # search indexes regardless of TLS mode.
    header X-Robots-Tag "noindex, nofollow"
    # The full tls{} directive lives in tls.conf (rendered by tls.conf.j2
    # per fleet_tls_mode: on_demand or ovh_dns) and is imported here by a
    # LITERAL path — Caddy hard-errors on a missing literal import, which is
    # correct since tls.conf is provisioned by this role and must always
    # exist. See fleet.core.caddyports for the sibling named-port snippets
    # that import the SAME file, so ovh_dns mode issues exactly one
    # wildcard cert shared across all of them.
    import {{ fleet_caddy_snippet_dir }}/tls.conf
}

# Fleet-managed named-port exposure (e.g. Typesense, Playwright reports):
# one snippet per port NAME with >=1 subscribing project, generated by
# fleet.core.caddyports and reconciled by `fleet refresh-ports` / deploy() /
# destroy() / daemon startup — never rendered by Ansible past the initial
# empty-directory seed below. A glob matching zero files is a verified
# silent Caddy no-op (same reasoning as the instances/*.conf auth import
# above), so an empty ports/ dir (e.g. right after provisioning, before
# any project opts into a named port) is not an error.
import {{ fleet_caddy_snippet_dir }}/ports/*.conf
