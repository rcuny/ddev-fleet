# Global options block — MUST be first in the Caddyfile (spec §9.3).
{
    email {{ acme_email }}
    on_demand_tls {
        ask http://127.0.0.1:{{ fleet_daemon_port }}/api/tls-authorize
    }
}

{{ fleet_domain }} {
    # Everything except the deploy-log WebSocket sits behind basic-auth.
    # Browsers do not send basic-auth credentials on a WebSocket handshake,
    # so /ws/* is exempted here; the daemon authenticates it instead with a
    # short-lived, instance-scoped token in the query string.
    @protected not path /ws/*
    basic_auth @protected {
        {{ fleet_admin_user }} {{ fleet_admin_bcrypt_hash }}
    }
    reverse_proxy 127.0.0.1:{{ fleet_daemon_port }}
}

*.{{ fleet_domain }} {
    # Caddy terminates the client TLS (on-demand cert per instance) and proxies
    # to DDEV's Traefik HTTP entrypoint. Proxying to Traefik's HTTPS port
    # ({{ ddev_router_https_port }}) instead returns 404 — Traefik's HTTPS router
    # matching does not engage for Caddy's proxied request — whereas the HTTP
    # entrypoint routes correctly by Host header. Caddy sets
    # X-Forwarded-Proto=https so Drupal still sees the request as secure; the
    # 127.0.0.1 hop is plaintext-safe (never leaves the host).
    reverse_proxy 127.0.0.1:{{ ddev_router_http_port }}
    tls {
        on_demand
    }
}
